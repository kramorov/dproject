{# Шаблон для описания электропривода - работает с сырыми данными #}

{% macro format_value(item) -%}
    {% if item is mapping and item.value is not none %}
        {{ item.value }}
        {%- if item.unit %} {{ item.unit }}{% endif -%}
    {% elif item is not mapping and item is not none %}
        {{ item }}
    {% else %}
        —
    {% endif %}
{%- endmacro %}

{% macro format_type(item) -%}
    {%- if item.is_default is defined and item.is_default -%}
        ✓ Стандарт
    {%- elif item.is_default is defined and not item.is_default -%}
        ⟳ Опция
    {%- else -%}
        —
    {%- endif -%}
{%- endmacro %}

{# Макрос для вывода опции в строке таблицы с раздельными столбцами #}
{% macro option_row(display_name, value, is_default) %}
    {% if display_name and value %}
        | {{ display_name }} | {{ value }} | {% if is_default %}✓ Стандарт{% endif %} | {% if not is_default %}⟳ Опция{% endif %} |
    {% endif %}
{% endmacro %}
{% macro option_row(display_name, value, is_default) %}
    {% if display_name and value %}
| {{ display_name }} | {{ value }} | {% if is_default %}✓ Стандарт{% else %}____-____{% endif %} | {% if not is_default %}⟳ Опция{% else %}___-___{% endif %} |
    {% endif %}
{% endmacro %}
