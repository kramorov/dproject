ell-input\" size=\"6\" @blur=\"savePrompt(p)\" /></td>\n            <td><input type=\"checkbox\" v-model=\"p.is_active\" @change=\"savePrompt(p)\" /></td>\n            <td>\n              <button class=\"btn-edit\" @click=\"editingPrompt = p\">Edit text</button>\n              <button class=\"btn-del\" @click=\"deletePrompt(p.id)\">✕</button>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n\n      <!-- Prompt editor modal -->\n      <div v-if=\"editingPrompt\" class=\"modal-overlay\" @click.self=\"editingPrompt = null\">\n        <div class=\"modal\">\n          <h3>{{ editingPrompt.code || editingPrompt.name }} v{{ editingPrompt.version }}</h3>\n          <textarea v-model=\"editingPrompt.template_text\" rows=\"20\" class=\"prompt-editor\"></textarea>\n          <div class=\"modal-actions\">\n            <button class=\"btn-save\" @click=\"savePrompt(editingPrompt); editingPrompt = null\">Save</button>\n            <button @click=\"editingPrompt = null\">Cancel</button>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- JSON Schemas -->\n    <section v-if=\"activeTab === 'schemas'\" class=\"section\">\n      <h2>JSON Schemas <button class=\"btn-add\" @click=\"addSchema\">+ Add</button></h2>\n      <table>\n        <thead><tr><th>Name</th><th>Version</th><th>Active</th><th></th></tr></thead>\n        <tbody>\n          <tr v-for=\"s in schemas\" :key=\"s.id\">\n            <td><input v-model=\"s.name\" class=\"cell-input\" @blur=\"saveSchema(s)\" /></td>\n            <td><input v-model=\"s.version\" class=\"cell-input\" size=\"6\" @blur=\"saveSchema(s)\" /></td>\n            <td><input type=\"checkbox\" v-model=\"s.is_active\" @change=\"saveSchema(s)\" /></td>\n            <td>\n              <button class=\"btn-edit\" @click=\"editingSchema = s\">Edit JSON</button>\n              <button class=\"btn-del\" @click=\"deleteSchema(s.id)\">✕</button>\n            </td>\n          </tr>\n        </tbody>\n      </table>\n\n