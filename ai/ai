          "content": "# ea_control/models/dictionaries.py\r\n\"\"\"\r\nСправочники физики БУ — копии справочников ЭП (изоляция от electric_actuators).\r\n\r\nЗачем копии: ea_control отлаживается как самостоятельная сущность, не\r\nзатрагивая рабочие модели ЭП (slots.md → «План: отладка паттерна…», Фаза 2).\r\nПосле отладки решится судьба оригиналов (слияние/замена). Коды записей\r\n**сохраняются как в оригинале** — они ключи маппинга при миграции данных.\r\n\r\nСостав:\r\n\r\n- ``CuControlSignalForm`` — электрические формы ВХОДНЫХ сигналов\r\n  (сухой контакт с внутренним опросом / потенциал AC/DC / петля 4–20 мА);\r\n- ``CuFeedbackSignalForm`` — электрические формы ВЫХОДНЫХ сигналов\r\n  (сухой контакт реле / петля 4–20 мА / потенциометр);\r\n- ``CuControlSignal`` ← EaControlSignal — входные команды БУ (роли;\r\n  форма — только у аналоговых уставок);\r\n- ``CuFeedbackSignal`` ← EaFeedbackSignal — выходные сигналы ОС;\r\n- ``CuCommProtocol`` ← EaCommProtocol — шинные протоколы;\r\n- ``CuFeedbackDevice`` ← EaFeedbackDevice — устройства ОС (датчики);\r\n- ``CuHeaterSupply`` ← params.ActuatorHeaterSupply — питание обогрева;\r\n- ``CuLocationOption`` ← params.ControlUnitLocationOption — место установки БУ;\r\n- ``CuCapability`` — новое: функции БУ, не являющиеся сигналами (PST,\r\n  datalogger, Bluetooth, ESD, PID, interrupter timer…);\r\n- ``CuLocalControlType`` — новое: вид органов местного управления\r\n  (кнопки/селекторы) для опций kind=local_control;\r\n- ``CuDisplayType`` — новое: вид отображения информации (светодиод /\r\n  мигающий светодиод / LCD) для опций kind=display.\r\n\r\nЛокализация: ``name``/``description`` — ru-поля для админки; переводы сайта —\r\n``name_i18n``/``description_i18n`` (LocalizedDictFieldsMixin). Коды и\r\nаббревиатуры не переводятся.\r\n\"\"\"\r\nfrom django.core.exceptions import ValidationError\r\nfrom django.db import models\r\nfrom django.utils.translation import gettext_lazy as _\r\n\r\nfrom core.models.mixins import (CopyMixin, LocalizedDictFieldsMixin,\r\n                                 OptionListToSelectMixin)\r\n\r\n\r\nclass CuControlSignalForm(CopyMixin, LocalizedDictFieldsMixin,\r\n                          OptionListToSelectMixin):\r\n    \"\"\"Электрическая форма входного (управляющего) сигнала БУ.\r\n\r\n    Зачем: физика ВХОДНЫХ клемм — как внешняя цепь подаёт команду:\r\n\r\n    - сухой контакт (внешняя сторона без потенциала; вход сам выдаёт\r\n      опорное напряжение — «+24 В от внутреннего источника»);\r\n    - потенциал AC/DC (напряжение подаётся прямо на клемму команды);\r\n    - токовая петля 4–20 мА (аналоговая уставка).\r\n\r\n    Форма дискретной команды определяется схемой цепей управления\r\n    (CuSignalPower.input_form), а не самим сигналом, поэтому\r\n    CuControlSignal ссылается на форму только для аналоговых уставок.\r\n    Отдельная сущность от CuFeedbackSignalForm: «сухой контакт» входа\r\n    (внутренний опрос) и выхода (коммутация реле) — разная физика.\r\n\r\n    Поля: code, name, category (dry_input/voltage_ac/voltage_dc/\r\n    current_4_20), description, sorting_order, is_active.\r\n    \"\"\"\r\n    code = models.CharField(\r\n        max_length=50, unique=True,\r\n        verbose_name=_(\"Код\"),\r\n        help_text=_(\"Уникальный код формы, например «DRY_INPUT», \"\r\n                    \"«AN_4_20_ACTIVE»\"),\r\n    )\r\n    name = models.CharField(\r\n        max_length=200,\r\n        verbose_name=_(\"Название\"),\r\n        help_text=_(\"Название формы, например «Сухой контакт, внутренний \"\r\n                    \"опрос +24 В»\"),\r\n    )\r\n    category = models.ForeignKey(\r\n        'electric_actuators.EaSignalFormCategory', on_delete=models.PROTECT,\r\n        related_name='cu_control_signal_forms',\r\n        verbose_name=_(\"Категория\"),\r\n        help_text=_(\"Категория входной формы: сухой контакт / потенциал AC / \"\r\n                    \"потенциал DC / петля 4–20 мА\"),\r\n    )\r\n    description = models.TextField(\r\n        blank=True,\r\n        verbose_name=_(\"Описание\"),\r\n        help_text=_(\"Пояснение формы: схема подключения, полярность, \"\r\n                    \"особенности\"),\r\n    )\r\n    sorting_order = models.IntegerField(default=0, verbose_name=_(\"Порядок сортировки\"))\r\n    is_active = models.BooleanField(default=True, verbose_name=_(\"Активно\"))\r\n\r\n    class Meta:\r\n        verbose_name = _(\"Форма управляющего сигнала БУ\")\r\n        verbose_name_plural = _(\"Формы управляющих сигналов БУ\")\r\n        ordering = ['sorting_order', 'code']\r\n\r\n    def __str__(self):\r\n        return self.name\r\n\r\n\r\nclass CuFeedbackSignalForm(CopyMixin, LocalizedDictFieldsMixin,\r\n                           OptionListToSelectMixin):\r\n    \"\"\"Электрическая форма выходного сигнала обратной связи БУ.\r\n\r\n    Зачем: физика ВЫХОДНЫХ клемм — чем БУ выдаёт сигнал наружу:\r\n\r\n    - сухие контакты реле (SPST/SPDT/DPDT — коммутируемая способность\r\n      описывается у сигнала: max_voltage/max_current/contact_normal);\r\n    - токовая петля 4–20 мА (активная/пассивная);\r\n    - потенциометр (сопротивление).\r\n\r\n    Отдельная сущность от CuControlSignalForm: «сухой контакт» выхода —\r\n    это коммутация внешней цепи, а не внутренний опрос входа.\r\n\r\n    Поля: code, name, category (dry_output/current_4_20/resistance),\r\n    description, sorting_order, is_active.\r\n    \"\"\"\r\n    code = models.CharField(\r\n        max_length=50, unique=True,\r\n        verbose_name=_(\"Код\"),\r\n        help_text=_(\"Уникальный код формы, например «DRY_SPDT», \"\r\n                    \"«AN_4_20_ACTIVE»\"),\r\n    )\r\n    name = models.CharField(\r\n        max_length=200,\r\n        verbose_name=_(\"Название\"),\r\n        help_text=_(\"Название формы, например «Сухой контакт SPDT»\"),\r\n    )\r\n    category = models.ForeignKey(\r\n        'electric_actuators.EaSignalFormCategory', on_delete=models.PROTECT,\r\n        related_name='cu_feedback_signal_forms',\r\n        verbose_name=_(\"Категория\"),\r\n        help_text=_(\"Категория выходной формы: сухой контакт / петля 4–20 мА / \"\r\n                    \"потенциометр\"),\r\n    )\r\n    description = models.TextField(\r\n        blank=True,\r\n        verbose_name=_(\"Описание\"),\r\n        help_text=_(\"Пояснение формы: схема подключения, особенности\"),\r\n    )\r\n    sorting_order = models.IntegerField(default=0, verbose_name=_(\"Порядок сортировки\"))\r\n    is_active = models.BooleanField(default=True, verbose_name=_(\"Активно\"))\r\n\r\n    class Meta:\r\n        verbose_name = _(\"Форма сигнала ОС БУ\")\r\n        verbose_name_plural = _(\"Формы сигналов ОС БУ\")\r\n        ordering = ['sorting_order', 'code']\r\n\r\n    def __str__(self):\r\n        return self.name\r\n\r\n\r\nclass _Analog4to20Mixin:\r\n    \"\"\"Общая валидация для сигналов с петлёй 4–20 мА и HART.\"\"\"\r\n\r\n    def validate_analog_fields(self, form, hart):\r\n        \"\"\"HART допустим только на аналоговой петле (категория формы analog).\"\"\"\r\n        if hart and form and form.category.code != 'analog':\r\n            raise ValidationError(\r\n                {'hart': _('HART допустим только для аналоговых форм 4–20 мА.')})\r\n\r\n\r\nclass CuControlSignal(_Analog4to20Mixin, CopyMixin, LocalizedDictFieldsMixin,\r\n                      OptionListToSelectMixin):\r\n    \"\"\"Входной (управляющий) сигнал БУ — справочник ролей и аналоговых уставок.\r\n\r\n    Зачем: справочник входных каналов БУ. Дискретные команды (Открыть/\r\n    Закрыть/Стоп/ESD) конфигурируются слотами узла «Дистанционное\r\n    управление» (опции — логики работы), их электрическая форма задаётся\r\n    выбранной схемой цепей (CuSignalPower); поэтому дискретные записи форму\r\n    не хранят (``form`` = null). Аналоговые уставки (4–20 мА) хранят форму\r\n    петли здесь.\r\n\r\n    Поля: role, category (discrete/analog), form (FK CuControlSignalForm,\r\n    только для аналоговых), current, wires, hart, code, name, description,\r\n    sorting_order, is_active.\r\n    \"\"\"\r\n    role = models.ForeignKey(\r\n        'electric_actuators.EaControlSignalRole', on_delete=models.PROTECT,\r\n        related_name='cu_control_signals',\r\n        verbose_name=_(\"Роль\"),\r\n        help_text=_(\"Смысловая роль команды: О/С/З, уставка, ESD, блокировка…\"),\r\n    )\r\n    category = models.CharField(\r\n        max_length=20,\r\n        choices=(('discrete', _('Дискретный')), ('analog', _('Аналоговый'))),\r\n        verbose_name=_(\"Категория\"),\r\n        help_text=_(\"Дискретная команда или аналоговая уставка\"),\r\n    )\r\n    form = models.ForeignKey(\r\n        CuControlSignalForm, on_delete=models.PROTECT, null=True, blank=True,\r\n        related_name='control_signals',\r\n        verbose_name=_(\"Форма\"),\r\n        help_text=_(\"Электрическая форма на клеммах; задаётся только для \"\r\n                    \"аналоговых уставок (AN_4_20_*), для дискретных команд — \"\r\n                    \"null (форма определяется схемой цепей управления)\"),\r\n    )\r\n    current = models.DecimalField(\r\n        max_digits=7, decimal_places=1, null=True, blank=True,\r\n        verbose_name=_(\"Ток входа, мА\"),\r\n        help_text=_(\"Потребление цепи входа, мА\"),\r\n    )\r\n    wires = models.PositiveIntegerField(\r\n        null=True, blank=True,\r\n        verbose_name=_(\"Проводов на канал\"),\r\n        help_text=_(\"Число проводов/клемм канала — данные для генератора схем\"),\r\n    )\r\n    hart = models.BooleanField(\r\n        default=False,\r\n        verbose_name=_(\"HART\"),\r\n        help_text=_(\"HART поверх петли 4–20 мА (только для форм AN_4_20_*)\"),\r\n    )\r\n    code = models.CharField(\r\n        max_length=50, unique=True,\r\n        verbose_name=_(\"Код\"),\r\n        help_text=_(\"Уникальный код сигнала, например «CMD_4_20MA»\"),\r\n    )\r\n    name = models.CharField(\r\n        max_length=200,\r\n        verbose_name=_(\"Название\"),\r\n        help_text=_(\"Название, например «Уставка положения 4–20 мА»\"),\r\n    )\r\n    description = models.TextField(\r\n        blank=True,\r\n        verbose_name=_(\"Описание\"),\r\n        help_text=_(\"Пояснение: полярность, контроль обрыва, примечания\"),\r\n    )\r\n    sorting_order = models.IntegerField(default=0, verbose_name=_(\"Порядок сортировки\"))\r\n    is_active = models.BooleanField(default=True, verbose_name=_(\"Активно\"))\r\n\r\n    class Meta:\r\n        verbose_name = _(\"Командный сигнал БУ\")\r\n        verbose_name_plural = _(\"Командные сигналы БУ\")\r\n        ordering = ['sorting_order', 'code']\r\n\r\n    def __str__(self):\r\n        return self.name\r\n\r\n    def clean(self):\r\n        super().clean()\r\n        self.validate_analog_fields(self.form, self.hart)\r\n        if self.category == 'analog':\r\n            if not self.form or self.form.category.code != 'current_4_20':\r\n                raise ValidationError(\r\n                    {'form': _('Для аналоговой уставки нужна форма AN_4_20_*.')})\r\n        elif self.form is not None:\r\n            raise ValidationError(\r\n                {'form': _('Форма задаётся только для аналоговых уставок; '\r\n                           'дискретная команда получает форму из схемы цепей '\r\n                           'управления (CuSignalPower).')})\r\n\r\n\r\nclass CuFeedbackSignal(_Analog4to20Mixin, CopyMixin, LocalizedDictFieldsMixin,\r\n                       OptionListToSelectMixin):\r\n    \"\"\"Выходной сигнал обратной связи БУ (копия EaFeedbackSignal).\r\n\r\n    Зачем: физика выходных клемм БУ — что он выдаёт наружу (концевые/путевые/\r\n    моментные контакты, позиция, перегрев, авария…). Одна запись = один канал\r\n    ОС. Для контактов ``max_voltage``/``max_current`` — коммутируемая\r\n    способность; для потенциометра — ``resistance_kohm``/``max_power_w``/\r\n    ``turns``; для петли — активность уже в форме.\r\n\r\n    Поля: role, category (contact/analog), form (FK CuSignalForm),\r\n    max_voltage, max_current, contact_normal, resistance_kohm, max_power_w,\r\n    turns, wires, hart, code (ключ маппинга), name, description,\r\n    sorting_order, is_active.\r\n    \"\"\"\r\n    role = models.ForeignKey(\r\n        'electric_actuators.EaFeedbackSignalRole', on_delete=models.PROTECT,\r\n        related_name='cu_feedback_signals',\r\n        verbose_name=_(\"Роль\"),\r\n        help_text=_(\"Смысловая роль: концевые/путевые/моментные, позиция, авария…\"),\r\n    )\r\n    category = models.CharField(\r\n        max_length=20,\r\n        choices=(('contact', _('Контакт')), ('analog', _('Аналоговый'))),\r\n        verbose_name=_(\"Категория\"),\r\n        help_text=_(\"Контакт (сухой) или аналоговый выход\"),\r\n    )\r\n    form = models.ForeignKey(\r\n        CuFeedbackSignalForm, on_delete=models.PROTECT,\r\n        related_name='feedback_signals',\r\n        verbose_name=_(\"Форма\"),\r\n        help_text=_(\"Электрическая форма на клеммах \"\r\n                    \"(DRY_*/AN_4_20_*/RES_POTENTIOMETER)\"),\r\n    )\r\n    max_voltage = models.DecimalField(\r\n        max_digits=7, decimal_places=1, null=True, blank=True,\r\n        verbose_name=_(\"Макс. коммутируемое напряжение, В\"),\r\n        help_text=_(\"Для контактов; null для аналоговых форм\"),\r\n    )\r\n    max_current = models.DecimalField(\r\n        max_digits=7, decimal_places=2, null=True, blank=True,\r\n        verbose_name=_(\"Макс. коммутируемый ток, А\"),\r\n        help_text=_(\"Для контактов; null для аналоговых форм\"),\r\n    )\r\n    contact_normal = models.ForeignKey(\r\n        'electric_actuators.EaContactNormal', on_delete=models.PROTECT,\r\n        null=True, blank=True,\r\n        related_name='cu_feedback_signals',\r\n        verbose_name=_(\"Нормальное состояние контакта\"),\r\n        help_text=_(\"NO/NC/перекидной — для контактных форм; null иначе\"),\r\n    )\r\n    resistance_kohm = models.DecimalField(\r\n        max_digits=7, decimal_places=2, null=True, blank=True,\r\n        verbose_name=_(\"Сопротивление, кОм\"),\r\n        help_text=_(\"Полное сопротивление потенциометра (для RES_POTENTIOMETER)\"),\r\n    )\r\n    max_power_w = models.DecimalField(\r\n        max_digits=7, decimal_places=2, null=True, blank=True,\r\n        verbose_name=_(\"Мощность, Вт\"),\r\n        help_text=_(\"Допустимая мощность потенциометра (для RES_POTENTIOMETER)\"),\r\n    )\r\n    turns = models.PositiveIntegerField(\r\n        null=True, blank=True,\r\n        verbose_name=_(\"Обороты\"),\r\n        help_text=_(\"Число оборотов потенциометра полного хода; null иначе\"),\r\n    )\r\n    wires = models.PositiveIntegerField(\r\n        null=True, blank=True,\r\n        verbose_name=_(\"Проводов на канал\"),\r\n        help_text=_(\"Число проводов/клемм канала — данные для генератора схем\"),\r\n    )\r\n    hart = models.BooleanField(\r\n        default=False,\r\n        verbose_name=_(\"HART\"),\r\n        help_text=_(\"HART поверх петли 4–20 мА (только для форм AN_4_20_*)\"),\r\n    )\r\n    code = models.CharField(\r\n        max_length=50, unique=True,\r\n        verbose_name=_(\"Код\"),\r\n        help_text=_(\"Уникальный код сигнала, например «FB_POS_4_20MA_ACTIVE»\"),\r\n    )\r\n    name = models.CharField(\r\n        max_length=200,\r\n        verbose_name=_(\"Название\"),\r\n        help_text=_(\"Название, например «Позиция 4–20 мА, активный»\"),\r\n    )\r\n    description = models.TextField(\r\n        blank=True,\r\n        verbose_name=_(\"Описание\"),\r\n        help_text=_(\"Пояснение: нагрузочная способность, примечания\"),\r\n    )\r\n    sorting_order = models.IntegerField(default=0, verbose_name=_(\"Порядок сортировки\"))\r\n    is_active = models.BooleanField(default=True, verbose_name=_(\"Активно\"))\r\n\r\n    class Meta:\r\n        verbose_name = _(\"Сигнал ОС БУ\")\r\n        verbose_name_plural = _(\"Сигналы ОС БУ\")\r\n        ordering = ['sorting_order', 'code']\r\n\r\n    def __str__(self):\r\n        return self.name\r\n\r\n    def clean(self):\r\n        super().clean()\r\n        self.validate_analog_fields(self.form, self.hart)\r\n        if self.category == 'contact' and self.form.category.code != 'dry_output':\r\n            raise ValidationError(\r\n                {'form': _('Для контакта нужна форма DRY_* (сухой выход).')})\r\n        if self.category != 'contact' and self.contact_normal:\r\n            raise ValidationError(\r\n                {'contact_normal': _('Нормальное состояние контакта задаётся '\r\n                                     'только для контактных сигналов.')})\r\n        if self.category == 'analog' and self.form.category.code not in (\r\n                'current_4_20', 'resistance'):\r\n            raise ValidationError(\r\n                {'form': _('Для аналогового сигнала нужна форма AN_4_20_* или '\r\n                           'RES_POTENTIOMETER.')})\r\n        if self.form.category.code == 'resistance' and not self.resistance_kohm:\r\n            raise ValidationError(\r\n                {'resistance_kohm': _('Для потенциометра обязательно '\r\n                                      'сопротивление.')})\r\n\r\n\r\nclass CuCommProtocol(CopyMixin, LocalizedDictFieldsMixin, OptionListToSelectMixin):\r\n    \"\"\"Шинный протокол связи БУ (копия EaCommProtocol).\r\n\r\n    Зачем: физика шины — какие протоколы поддерживает БУ (Modbus RTU/TCP,\r\n    PROFIBUS DP, PROFINET, Foundation Fieldbus…). HART сюда не входит — это\r\n    атрибут сигнала петли 4–20 мА.\r\n\r\n    Поля: code (ключ маппинга), name, transport, description, sorting_order,\r\n    is_active.\r\n    \"\"\"\r\n    code = models.CharField(\r\n        max_length=50, unique=True,\r\n        verbose_name=_(\"Код\"),\r\n        help_text=_(\"Уникальный код протокола, например «MODBUS_RTU»\"),\r\n    )\r\n    name = models.CharField(\r\n        max_length=200,\r\n        verbose_name=_(\"Название\"),\r\n        help_text=_(\"Название протокола, например «Modbus RTU»\"),\r\n    )\r\n 