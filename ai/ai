s=\"eng-filter-bar__chip-select\" v-model=\"form.manual_override_id\">\n            <option value=\"\">{{ t('catalog.engineer.notSpecified') }}</option>\n            <option v-for=\"v in actuatorOptions.manual_override_options\" :key=\"v.id\" :value=\"v.id\">{{ v.name }}</option>\n          </select>\n        </div>\n        <div class=\"eng-filter-bar__chip\">\n          <label class=\"eng-filter-bar__chip-label\">{{ label('temp_min') }}</label>\n          <input type=\"number\" step=\"1\" class=\"eng-filter-bar__chip-input\" v-model.number=\"form.temp_min\" />\n        </div>\n        <div class=\"eng-filter-bar__chip\">\n          <label class=\"eng-filter-bar__chip-label\">{{ label('temp_max') }}</label>\n          <input type=\"number\" step=\"1\" class=\"eng-filter-bar__chip-input\" v-model.number=\"form.temp_max\" />\n        </div>\n      </div>\n\n      <!-- Exd-каскад (как в limit-switch) -->\n      <div class=\"eng-filter-bar__special\">\n        <ExdFilter @update:modelValue=\"onExdChange\" @update:exactId=\"onExdExact\" />\n      </div>\n\n      <div class=\"pa-engineer__actions\">\n        <button class=\"btn-primary\" @click=\"search\" :disabled=\"searching\">\n          {{ searching ? t('catalog.common.search') : t('pa.engineer.search') }}\n        </button>\n      </div>\n    </div>\n\n    <div v-if=\"error\" class=\"error-msg\">❌ {{ error }}</div>\n\n    <section v-if=\"cards.length\" class=\"results\">\n      <h2>{{ t('pa.engineer.results') }}</h2>\n      <SelectionResultGrid\n        :items=\"cards\"\n        :total=\"cards.length\"\n        :loading=\"searching\"\n        :empty-text=\"t('catalog.common.nothingFound')\"\n        @select=\"onSelectCard\"\n      />\n    </section>\n  </div>\n</template>\n\n<script>\nimport api from '@/shared/api'\nimport PageTitle from '@/shared/components/PageTitle.vue'\nimport ExdFilter from '@/shared/components/ExdFilter.vue'\nimport SelectionResultGrid from '@/shared/components/catalog/SelectionResultGrid.vue'\nimport { useI18n } from '@/shared/i18n'\nimport { paResultsToCards, buildPaConfigQuery } from '@/shared/utils/paResults'\n\nexport default {\n  name: 'PaEngineerSelector',\n  components: { PageTitle, ExdFilter, SelectionResultGrid },\n  setup() {\n    const { t } = useI18n()\n    return { t }\n  },\n  data() {\n    return {\n      labels: {},\n      refs: {\n        valve_types: [], dn_varieties: [], pn_varieties: [],\n        mounting_plates: [], stem_shapes: [], stem_sizes: [],\n        air_pressure: [], model_lines: [], construction_varieties: [],\n      },\n      actuatorOptions: {\n        actuator_varieties: [], safety_positions: [],\n        ip_options: [], exd_options: [], coating_options: [], manual_override_options: [],\n      },\n      form: {\n        valve_type_id: null, dn_id: null, pn_id: null,\n        mounting_plate_id: null, stem_shape_id: null, stem_id: null,\n        torque_without_safety: 0, safety_factor: 1.5,\n        model_line_id: null,\n        construction_variety_id: null,\n        actuator_variety_id: null, safety_position_id: null,\n        air_pressure_id: null, ip_id: null, exd_id: '', exd_id_exact: '',\n        coating_id: null, manual_override_id: null,\n        temp_min: 0, temp_max: 0,\n      },\n      results: [],\n      error: '',\n      searching: false,\n    }\n  },\n  computed: {\n    title() { return this.t('pa.engineer.title') },\n    torqueWithSafety() {\n      return (this.form.torque_without_safety * this.form.safety_factor).toFixed(1)\n    },\n    filteredStems() {\n      if (!this.form.stem_shape_id) return this.refs.stem_sizes\n      return this.refs.stem_sizes.filter(s => s.stem_shape_id === this.form.stem_shape_id)\n    },\n    filteredModelLines() {\n      if (!this.form.construction_variety_id) return this.refs.model_lines\n      return this.refs.model_lines.filter(\n        ml => ml.pneumatic_actuator_construction_variety_id === this.form.construction_variety_id\n      )\n    },\n    actuatorVarieties() { return this.actuatorOptions.actuator_varieties || [] },\n    safetyPositions() { return this.actuatorOptions.safety_positions || [] },\n    cards() { return paResultsToCards(this.results) },\n  },\n  watch: {\n    'form.construction_variety_id'() { this.form.model_line_id = null },\n    'form.model_line_id'() {\n      this.form.actuator_variety_id = null\n      this.form.safety_position_id = null\n      this.actuatorOptions.safety_positions = []\n      this.loadActuatorOptions()\n    },\n  },\n  async created() {\n    await this.loadInitialData()\n    await this.loadActuatorOptions()\n  },\n  methods: {\n    label(key) {\n      return this.labels[key] || key\n    },\n    async loadInitialData() {\n      try {\n        const { data } = await api.get('/pneumatic_actuators/selector/initial-data/')\n        this.labels = data.labels || {}\n        this.refs = { ...this.refs, ...data }\n      } catch (e) {\n        this.error = 'Ошибка загрузки справочников: ' + (e.displayMessage || e.message)\n      }\n    },\n    async loadActuatorOptions() {\n      try {\n        const params = {}\n        if (this.form.model_line_id) params.model_line_id = this.form.model_line_id\n        if (this.form.actuator_variety_id) params.actuator_variety_id = this.form.actuator_variety_id\n        const { data } = await api.get('/pneumatic_actuators/options/', { params })\n        this.actuatorOptions = data\n        // DA имеет единственное положение безопасности («Оставаться в текущем положении») — автовыбор.\n        if (data.safety_positions && data.safety_positions.length === 1) {\n          this.form.safety_position_id = data.safety_positions[0].id\n        }\n      } catch (e) {\n        console.error('loadActuatorOptions failed:', e.displayMessage || e.message)\n      }\n    },\n    onVarietyChange() {\n      this.form.safety_position_id = null\n      this.actuatorOptions.safety_positions = []\n      this.loadActuatorOptions()\n    },\n    onStemShapeChange() { this.form.stem_id = null },\n    onExdChange(ids) {\n      if (!ids || !ids.length) this.form.exd_id = ''\n      else if (ids[0] === '_none_' || ids[0] === '_empty_') this.form.exd_id = ids[0]\n      else this.form.exd_id = ids.join(',')\n    },\n    onExdExact(id) { this.form.exd_id_exact = id != null ? id : '' },\n    async search() {\n      this.searching = true\n      this.error = ''\n      this.results = []\n\n      if (!this.form.torque_without_safety || this.form.torque_without_safety <= 0) {\n        this.error = this.t('pa.engineer.errorTorque'); this.searching = false; return\n      }\n      if (!this.form.air_pressure_id) {\n        this.error = this.t('pa.engineer.errorPressure'); this.searching = false; return\n      }\n      if (!this.form.actuator_variety_id) {\n        this.error = this.t('pa.engineer.errorVariety'); this.searching = false; return\n      }\n      if (!this.form.safety_position_id) {\n        this.error = this.t('pa.engineer.errorSafety'); this.searching = false; return\n      }\n\n      const varietyObj = this.actuatorVarieties.find(v => v.id === this.form.actuator_variety_id)\n      const actuator_variety_code = varietyObj?.code || 'DA'\n\n      try {\n        const payload = {\n          ...this.form,\n          actuator_variety_code,\n          torque_with_safety: parseFloat(this.torqueWithSafety),\n        }\n        const { data } = await api.post('/pneumatic_actuators/selector/search/', payload)\n        this.results = data.search_results || []\n        if (!this.results.length) this.error = this.t('catalog.common.nothingFound')\n      } catch (e) {\n        this.error = e.response?.data?.error || e.displayMessage || this.t('pa.engineer.errorGeneric')\n      } finally {\n        this.searching = false\n      }\n    },\n    openProduct(item, ml, options = {}) {\n      if (!item?.model_line_item_id) return\n      this.$router.push({ path: '/catalog/pa-actuators', query: buildPaConfigQuery(ml, item, options) })\n    },\n    collectOptions() {\n      const o = {}\n      if (this.form.safety_position_id) o.safety_position = this.form.safety_position_id\n      if (this.form.ip_id) o.ip = this.form.ip_id\n      if (this.form.exd_id) o.exd = this.form.exd_id\n      if (this.form.manual_override_id) o.manual_override = this.form.manual_override_id\n      if (this.form.coating_id) o.body_coating = this.form.coating_id\n      return o\n    },\n    onSelectCard(id) {\n      const c = this.cards.find(x => x.id === id)\n      if (c) this.openProduct(c._item, c._ml, this.collectOptions())\n    },\n    reset() {\n      this.form = {\n        valve_type_id: null, dn_id: null, pn_id: null,\n        mounting_plate_id: null, stem_shape_id: null, stem_id: null,\n        torque_without_safety: 0, safety_factor: 1.5,\n        model_line_id: null, model_line_item_id: null,\n        construction_variety_id: null,\n        actuator_variety_id: null, safety_position_id: null,\n        air_pressure_id: null, ip_id: null, exd_id: '', exd_id_exact: '',\n        coating_id: null, manual_override_id: null,\n        temp_min: 0, temp_max: 0,\n      }\n      this.results = []\n      this.error = ''\n    },\n  },\n}\n</script>\n\n<style scoped>\n.pa-engineer { max-width: 1200px; margin: 0 auto; padding: var(--cat-gap-xl, 16px); }\n.eng-filter-bar {\n  background: var(--cat-surface, #fff);\n  border: 1px solid var(--cat-border, #e5e7eb);\n  border-radius: var(--cat-radius-lg, 10px);\n  padding: 12px 16px;\n  margin-bottom: 20px;\n}\n.eng-filter-bar__header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }\n.eng-filter-bar__title { font-size: 13px; font-weight: 600; color: var(--cat-muted, #6b7280); text-transform: uppercase; letter-spacing: .5px; }\n.eng-filter-bar__reset { padding: 4px 12px; font-size: 12px; background: var(--cat-bg, #f3f4f6); border: 1px solid var(--cat-border, #d1d5db); border-radius: 4px; cursor: pointer; color: var(--cat-muted, #6b7280); }\n.eng-filter-bar__chips { display: flex; flex-w