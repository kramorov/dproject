                "content": "# Smoke P7: API-контракт pa-catalog / pa-constructor (test client, откат данных)\nfrom django.test import Client\nfrom pneumatic_actuators.models import (\n    PneumaticActuatorModelLine, PneumaticActuatorModelLineItem, PneumaticActuatorItem,\n)\nfrom sku.models import SKU\n\nc = Client()\n\n# 1. Справочники\nr = c.get('/pneumatic_actuators/constructor/model_lines/')\nprint('model_lines:', r.status_code, '| n =', len(r.json()))\nassert r.status_code == 200\n\nml = PneumaticActuatorModelLine.objects.filter(is_active=True).first()\nr = c.get(f'/pneumatic_actuators/constructor/model-lines/{ml.id}/items/')\nprint('model_line_items:', r.status_code, '| n =', len(r.json()))\nassert r.status_code == 200\n\nmli = PneumaticActuatorModelLineItem.objects.filter(model_line=ml, is_active=True).first()\nr = c.get('/pneumatic_actuators/constructor/options/', {'model_line_item_id': mli.id})\nprint('options:', r.status_code, '| keys =', list(r.json().keys())[:6])\nassert r.status_code == 200\n\n# 2. Превью (как шлёт PaQuickSelect)\nr = c.post('/pneumatic_actuators/constructor/preview/', {\n    'selected_model_line_item': mli.id,\n    'selected_safety_position': None, 'selected_springs_qty': None,\n    'selected_temperature': None, 'selected_ip': None, 'selected_exd': None,\n    'selected_body_coating': None, 'selected_hand_wheel': None,\n}, content_type='application/json')\nprint('preview:', r.status_code, '| code =', r.json().get('code'))\nassert r.status_code == 200\n\n# 3. Селектор (подбор по моменту)\nr = c.get('/pneumatic_actuators/selector/initial-data/')\nprint('selector initial:', r.status_code)\nassert r.status_code == 200\n\nr = c.post('/pneumatic_actuators/selector/search/', {\n    'torque_without_safety': 50, 'safety_factor': 1.5,\n    'air_pressure_id': None, 'actuator_variety_code': 'DA',\n}, content_type='application/json')\nprint('selector search:', r.status_code, '| success =', r.json().get('success'))\nassert r.status_code == 200\n\n# 4.