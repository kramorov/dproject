 description_template=unit.description_template,\n        spec_template=unit.spec_template,\n        name_template_i18n=unit.name_template_i18n,\n        description_template_i18n=unit.description_template_i18n,\n        description=unit.description, sorting_order=unit.sorting_order + 1,\n        is_active=unit.is_active)\n    new.accepts.set(unit.accepts.all())\n    new.emits.set(unit.emits.all())\n    new.protocols.set(unit.protocols.all())\n    new.capabilities.set(unit.capabilities.all())\n    # опция слота control_unit\n    from ea_control.models import CuSlot, CuSlotOption, CuSlotRule\n    old_opt = CuSlotOption.objects.filter(slot__code='control_unit', control_unit=unit).first()\n    new_opt = None\n    if old_opt:\n        opt_base = old_opt.code\n        m = 1\n        opt_code = f'{opt_base}_CP{m}'\n        while CuSlotOption.objects.filter(code=opt_code).exists():\n            m += 1\n            opt_code = f'{opt_base}_CP{m}'\n        new_opt = CuSlotOption.objects.create(\n            code=opt_code, slot=old_opt.slot, kind='unit',\n            control_unit=new, encoding=old_opt.encoding,\n            ext_encoding=old_opt.ext_encoding, sorting_order=old_opt.sorting_order,\n            is_active=old_opt.is_active)\n    # профильные строки матрицы\n    old_rows = list(CuMatrixEntry.objects.filter(control_unit=unit))\n    id_map = {}\n    for r in old_rows:\n        nr = CuMatrixEntry.objects.create(\n            slot=r.slot, option=r.option, brand=r.brand, model_line=r.model_line,\n            body=r.body, model_line_item=r.model_line_item, control_unit=new,\n            power_supply=r.power_supply, mode=r.mode,\n            control_signal=r.control_signal, feedback_signal=r.feedback_signal,\n            protocol=r.protocol, device=r.device, heater_supply=r.heater_supply,\n            availability=r.availability, is_default=r.is_default,\n            bundle=r.bundle, encoding=r.encoding, ext_encoding=r.ext_encoding,\n            name=r.name, description=r.