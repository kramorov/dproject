es',      name='Pipeline-настройки',type='page'),\n    SystemObject(codename='ai.debug',          name='Отладка AI',        type='page'),\n    # Каталоги (публичные)\n    SystemObject(codename='catalog.gearbox',   name='Ручные дублёры',    type='catalog'),\n    SystemObject(codename='catalog.pa',         name='Пневмоприводы',     type='catalog'),\n    SystemObject(codename='catalog.lsb',       name='БКВ',               type='catalog'),\n    SystemObject(codename='catalog.sv',        name='Соленоидные клапаны',type='catalog'),\n    SystemObject(codename='catalog.fr',        name='Фильтр-регуляторы', type='catalog'),\n    SystemObject(codename='catalog.pf',        name='Пневмофитинги',     type='catalog'),\n])\n```\n\n---\n\n## Как это работает на всех слоях\n\n### 1. Бэкенд: permission class\n\n```python\nclass SystemObjectPermission(BasePermission):\n    def has_permission(self, request, view):\n        obj = getattr(view, 'required_object', None)\n        action = getattr(view, 'required_action', 'view')\n        if obj is None:\n            return True\n\n        profile = get_customer_profile(request)\n        if not profile:\n            return False\n\n        return profile.system_groups.filter(\n            object_permissions__object__codename=obj,\n            **{f'object_permissions__can_{action}': True}\n        ).exists()\n\n# Использование:\nclass PAConstructorView(APIView):\n    permission_classes = [IsAuthenticated, SystemObjectPermission]\n    required_object = 'configurator.pa'\n    required_action = 'view'     # или 'edit' для POST/PUT\n```\n\n### 2. Фронтенд: роутер\n\n```javascript\nconst routes = [\n  { path: '/configurator/pa',   meta: { object: 'configurator.pa',   action: 'view' } },\n  { path: '/admin/customers',   meta: { object: 'admin.customers',   action: 'view' } },\n  { path: '/admin/permissions', meta: { object: 'admin.permissions', action: 'edit' } },\n  { path: '/catalog/gearbox',   meta: { object: 'catalog.gearbox',   action: 'view'