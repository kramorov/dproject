  ws = wb.active\n    ws.title = 'Структура'\n    ws.append(['Раздел', 'Поле', 'Значение'])\n    grid_no = 0\n    for entry in _iter_rows(structure.get('items') or []):\n        if entry[0] == 'grid':\n            _, path, headers, rows = entry\n            grid_no += 1\n            sheet = wb.create_sheet(f'Таблица {grid_no}')\n            if headers:\n                sheet.append(headers)\n            else:\n                width = max((len(r) for r in rows), default=0)\n                sheet.append([f'Столбец {i+1}' for i in range(width)])\n            for r in rows:\n                sheet.append(list(r))\n            ws.append([path, '', f'Таблица {grid_no} → лист «Таблица {grid_no}»'])\n        else:\n            _, path, field, value = entry\n            ws.append([path, field, value])\n    buf = BytesIO()\n    wb.save(buf)\n    return buf.getvalue()\n```\n\nHmm — when no headers, adding \"Столбец N\" row as header is helpful. OK.\n\ndocx:\n```python\ndef _render_docx_items(doc, items, level=0):\n    for item in items:\n        kind = item.get('kind')\n        if kind == 'section':\n            doc.add_heading(item.get('title') or '', level=min(level+1, 4))\n            _render_docx_items(doc, item.get('children') or [], level+1)\n        elif kind == 'text':\n            text = (item.get('text') or '').strip()\n            if text:\n                doc.add_paragraph(text)\n        elif kind == 'field':\n            # устаревший\n            field = item.get('field') or ''\n            values = item.get('values') or []\n            for v in values: doc.add_paragraph(f'{field}: {_flatten_value(v)}') if field else doc.add_paragraph(_flatten_value(v))\n            if not values and field: doc.add_paragraph(field)\n        elif kind == 'table':\n            variant = item.get('variant') or 'fv'\n            rows = item.get('rows') or []\n            if not rows:\n                continue\n            if variant == 'grid':\n                headers = item.get('heade