          "content": "\"\"\"\nconfigurator/services/resolver.py\n\nВычисляет effective_requirements для ComponentRequirement\nна основе PropagationRule и трансляции ключей.\n\nВызывается после изменения own_requirements или global_requirements:\n    resolve_effective_requirements(component)\n    → component.effective_requirements заполняется\n\"\"\"\nfrom __future__ import annotations\n\nimport logging\nfrom typing import Optional\n\nfrom django.core.exceptions import ObjectDoesNotExist\n\nfrom configurator.models import (\n    ComponentRequirement,\n    PropagationRule,\n)\nfrom configurator.services.registry import get_product_model_class\n\nlogger = logging.getLogger(__name__)\n\n\ndef resolve_effective_requirements(component: ComponentRequirement) -> dict:\n    \"\"\"\n    Вычисляет effective_requirements для одного компонента.\n\n    Алгоритм:\n      1. Загружаем все PropagationRule для equipment_type компонента\n      2. Для каждого правила определяем источник значения:\n         - source=global  → assembly.global_requirements[source_param]\n         - source=parent  → parent.effective_requirements[source_param]\n         - source=user    → own_requirements[param_name]\n         - source=derived → cascade_params[param_name]\n      3. Применяем allow_override (own имеет приоритет)\n      4. Транслируем ключи: FilterDefinition.param_name → model_field\n      5. Сохраняем результат в component.effective_requirements\n\n    Returns:\n        Словарь effective_requirements (ключи — поля БД продукта).\n    \"\"\"\n    if not component.equipment_type:\n        logger.warning(\"ComponentRequirement #%d has no equipment_type, skipping\", component.id)\n        component.effective_requirements = {}\n        component.save(update_fields=['effective_requirements'])\n        return {}\n\n    assembly = component.assembly\n\n    # 1. PropagationRules для этого equipment_type\n    rules = PropagationRule.objects.filter(\n        equipment_type=component.equipment_type,\n        is_active=True,\n    ).order_by('priority')\n\n    # 2. Строим translation map: FilterDefinition.param_name → model_field\n    translation = _build_translation_map(component.equipment_type)\n\n    # 3. Резолвим каждое правило\n    effective: dict[str, object] = {}\n    own = component.own_requirements or {}\n\n    for rule in rules:\n        value = _resolve_rule_value(rule, component, assembly)\n\n        # allow_override: своё значение приоритетнее источника\n        if rule.allow_override and rule.param_name in own:\n            value = own[rule.param_name]\n\n        if value is not None:\n            effective[rule.param_name] = value\n\n    # 4. Добавляем cascade_params (если есть)\n    cascade = component.cascade_params or {}\n    for param_name, value in cascade.items():\n        if param_name not in effective:\n            effective[param_name] = value\n\n    # 5. Транслируем ключи: param_name → model_field\n    translated = {}\n    for api_key, value in effective.items():\n        model_field = translation.get(api_key, api_key)\n        translated[model_field] = value\n\n    # 6. Сохраняем\n    component.effective_requirements = translated\n    component.save(update_fields=['effective_requirements'])\n\n    logger.debug(\n        \"Resolved effective requirements for CR #%d [%s]: %d params → %d fields\",\n        component.id,\n        component.equipment_type.code,\n        len(effective),\n        len(translated),\n    )\n    return translated\n\n\ndef _resolve_rule_value(\n    rule: PropagationRule,\n    component: ComponentRequirement,\n    assembly,\n) -> Optional[object]:\n    \"\"\"Получить значение параметра из источника, указанного в PropagationRule.\"\"\"\n    if rule.source == 'global':\n        global_req = assembly.global_requirements or {}\n        param = rule.source_param or rule.param_name\n        return global_req.get(param)\n\n    elif rule.source == 'parent':\n        parent = component.parent\n        if parent and parent.effective_requirements:\n            param = rule.source_param or rule.param_name\n            return parent.effective_requirements.get(param)\n        return None\n\n    elif rule.source == 'user':\n        own = component.own_requirements or {}\n        return own.get(rule.param_name)\n\n    elif rule.source == 'derived':\n        cascade = component.cascade_params or {}\n        return cascade.get(rule.param_name)\n\n    return None\n\n\ndef _build_translation_map(equipment_type) -> dict[str, str]:\n    \"\"\"\n    Строит словарь трансляции: FilterDefinition.param_name → model_field.\n\n    Использует FILTER_DEFINITIONS продукт-модели для данного equipment_type.\n    Если FILTER_DEFINITIONS пуст — возвращает пустой словарь\n    (ключи останутся без изменений).\n    \"\"\"\n    try:\n        model_class = get_product_model_class(equipment_type)\n    except KeyError:\n        return {}\n\n    filter_defs = getattr(model_class, 'FILTER_DEFINITIONS', None)\n    if not filter_defs:\n        return {}\n\n    return {\n        fd.param_name: fd.model_field\n        for fd in filter_defs\n        if hasattr(fd, 'param_name') and hasattr(fd, 'model_field')\n    }\n\n\ndef resolve_all_components(assembly) -> None:\n    \"\"\"\n    Резолвит effective_requirements для ВСЕХ компонентов сборки.\n\n    Вызывается при изменении global_requirements — значения из global\n    распространяются на все компоненты с PropagationRule.source='global'.\n    \"\"\"\n    components = assembly.components.filter(\n        equipment_type__isnull=False,\n    ).select_related('equipment_type', 'parent').order_by('level', 'path')\n\n    for cr in components:\n        resolve_effective_requirements(cr)"
