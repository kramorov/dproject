als',\r\n        'protocol': 'protocols',\r\n        'heater_supply': 'heaterSupplies',\r\n        'signal_power': 'signalPowers',\r\n        'control_logic': 'controlLogics',\r\n        'control_unit': 'units',\r\n        'device': 'devices',\r\n        'local_control': 'localControlTypes',\r\n        'display': 'displayTypes',\r\n        'unit_power': 'unitPowerSources',\r\n        'cable_gland': 'cgHoleSets',\r\n        'location': 'locationOptions',\r\n        'access_device': 'accessDevices',\r\n    }\r\n    slot_sources = []\r\n    for value, label in CuSlot._meta.get_field('source').choices:\r\n        kind, field = SLOT_SOURCE_PAYLOAD.get(value, (None, None))\r\n        slot_sources.append({\r\n            'value': value, 'label': str(label), 'kind': kind,\r\n            'field': field, 'dict': _source_dicts.get(value, ''),\r\n            'multiple': field == 'display_types',\r\n        })\r\n    return Response({\r\n        'model_lines': model_lines,\r\n        'power_supplies': power_supplies,\r\n        'brands': brands,\r\n        'bodies': bodies,\r\n        'model_line_items': model_line_items,\r\n        'thread_sizes': thread_sizes,\r\n        'cg_hole_sets': cg_hole_sets,\r\n        'selection_modes': selection_modes,\r\n        'slot_kinds': slot_kinds,\r\n        'slot_sources': slot_sources,\r\n    })\r\n\r\n\r\n@api_view(['GET'])\r\n@permission_classes([IsAdminUser])\r\ndef series_units_view(request):\r\n    \"\"\"Доступные типы БУ для серии/напряжения (слот control_unit).\"\"\"\r\n    from electric_actuators.models import ElectricActuatorModelLine\r\n    from params.models import PowerSupplies\r\n\r\n    try:\r\n        model_line = ElectricActuatorModelLine.objects.get(\r\n            pk=request.query_params['model_line'])\r\n    except (KeyError, ElectricActuatorModelLine.DoesNotExist):\r\n        return Response({'error': 'model_line обязателен'}, status=400)\r\n    power_supply = None\r\n    ps_id = request.query_params.get('power_supply')