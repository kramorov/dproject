atList.value.find(x => x.node.uid === dragUid)\n  dragUid = null\n  if (!src) return\n  const srcNode = src.node\n  if (srcNode.kind === 'section' && containsUid(srcNode, f.node.uid)) return  // в себя/потомка\n  src.parentArray.splice(src.index, 1)\n  const dst = flatList.value.find(x => x.node.uid === f.node.uid)\n  if (!dst) { tree.value.push(srcNode); return }  // fallback\n  if (f.node.kind === 'section') {\n    f.node.children.push(srcNode)\n  } else {\n    dst.parentArray.splice(dst.index, 0, srcNode)\n  }\n}\n```\n\ncontainsUid(node, uid): if node.uid===uid return true; walk children.\n\nNote: `f` here is a stale flatList snapshot; after splice, re-find dst. But `f.node.kind === 'section'` — f.node is the live object, fine.\n\nEdge: dropping a node onto a block in same parent: [A, B], drag A onto B → remove A → [B], dst.index=0 → insert A at 0 → [A, B] (unchanged). Dragging B onto A: remove B → [A], dst.index 0, insert B at 0 → [B, A] — reorder works.\n\ndrop on section inserts into children (end). Good.\n\nRecognition functions:\n\n```js\nfunction regionFd(nat, kind) {\n  const fd = new FormData()\n  fd.append('file', file.value)\n  fd.append('kind', kind)\n  fd.append('x', nat.x); fd.append('y', nat.y); fd.append('w', nat.w); fd.append('h', nat.h)\n  return fd\n}\nasync function ocrText(nat) {\n  const { data } = await api.post('/admin/media/ocr/region/', regionFd(nat, 'text'), { headers: { 'Content-Type': 'multipart/form-data' } })\n  return data.text || ''\n}\nasync function fvTable(nat) {\n  const { data } = await api.post('/admin/media/ocr/region/', regionFd(nat, 'fvtable'), { headers: { 'Content-Type': 'multipart/form-data' } })\n  return data.rows || []\n}\nasync function gridTable(nat) {\n  const fd = new FormData()\n  fd.append('file', file.value)\n  fd.append('use_first_row_as_header', useHeader.value ? 'true' : 'false')\n  fd.append('borderless_tables', borderless.value ? 'true' : 'false')\n  fd.append('region_x', nat.x); fd.append('region_y', nat.y)\n  fd.append('region_w', nat.w); fd.append('region_h', nat.h)\n  const { data } = await api.post('/admin/media/ocr/recognize/', fd, { headers: { 'Content-Type': 'multipart/form-data' } })\n  const t = data?.pages?.[0]?.tables?.[0]\n  if (!t) throw new Error('Таблица в области не найдена.')\n  return {\n    headers: (t.columns || []).map(c => c == null ? '' : String(c)),\n    rows: (t.rows || []).map(r => (r || []).map(c => c == null ? '' : String(c))),\n  }\n}\n```\n\nprocessSelection:\n\n```js\nasync function processSelection(nat) {\n  const m = selMode.value\n  selMode.value = null\n  busy.value = true\n  error.value = ''\n  try {\n    if (m === 'section') addSection(await ocrText(nat), nat)\n    else if (m === 'text') addText(await ocrText(nat), nat)\n    else if (m === 'fv') addFvTable(await fvTable(nat), nat)\n    else if (m === 'grid') addGridTable(await gridTable(nat), nat)\n  } catch (e) {\n    error.value = e?.displayMessage || e?.message || 'Ошибка распознавания фрагмента'\n  } finally {\n    busy.value = false\n  }\n}\n```\n\nAdd functions:\n\n```js\nfunction makeUid() { return ++uidSeq }\nfunction findSection(nodes, uid) {\n  for (const n of nodes) {\n    if (n.kind === 'section') {\n      if (n.uid === uid) return n\n      const r = findSection(n.children, uid)\n      if (r) return r\n    }\n  }\n  return null\n}\nfunction activeContainer() {\n  if (activeSectionUid.value) {\n    const s = findSection(tree.value, activeSectionUid.value)\n    if (s) return s.children\n  }\n  return tree.value\n}\nfunction addSection(title, region) {\n  const node = { uid: makeUid(), kind: 'section', title, region, children: [] }\n  activeContainer().push(node)\n  activeSectionUid.value = node.uid\n  flash('Раздел добавлен — следующие фрагменты попадут в него')\n}\nfunction addText(text, region) {\n  const node = { uid: makeUid(), kind: 'text', text, region }\n  activeContainer().push(node)\n  flash('Текст добавлен')\n}\nfunction addFvTable(rows, region) {\n  const node = { uid: makeUid(), kind: 'table', variant: 'fv', region, rows: (rows || []).map(r => ({ field: r.field || '', value: r.value || '' })) }\n  activeContainer().push(node)\n  flash('Таблица F-V добавлена')\n}\nfunction addGridTable(tbl, region) {\n  const node = { uid: makeUid(), kind: 'table', variant: 'grid', region, headers: tbl.headers, rows: tbl.rows }\n  activeContainer().push(node)\n  flash('Таблица добавлена')\n}\n```\n\nflatList:\n\n```js\nconst flatList = computed(() => {\n  const out = []\n  const walk = (nodes, depth, parentArray, ownerUid) => {\n    for (let i = 0; i < nodes.length; i++) {\n      const n = nodes[i]\n      out.push({ node: n, depth, parentArray, index: i, ownerUid })\n      if (n.kind === 'section') walk(n.children, depth + 1, n.children, n.uid)\n    }\n  }\n  walk(tree.value, 0, tree.value, null)\n  return out\n})\n```\n\noverlays:\n\n```js\nconst overlays = computed(() => {\n  const out = []\n  const walk = (nodes) => {\n    for (const n of nodes) {\n      if (n.region) out.push({ uid: n.uid, kind: n.kind === 'table' ? (n.variant === 'grid' ? 'grid' : 'fv') : n.kind, region: n.region })\n      if (n.kind === 'section') walk(n.children)\n    }\n  }\n  walk(tree.value)\n  return out\n})\n```\n\nDisplay helpers: kindLabel, fragText, isFv, isGrid:\n\n```js\nfunction kindLabel(f) {\n  const n = f.node\n  if (n.kind === 'section') return 'раздел'\n  if (n.kind === 'text') return 'текст'\n  if (n.kind === 'table') return n.variant === 'grid' ? 'таблица' : 'таблица F-V'\n  return ''\n}\nfunction isFv(f) { return f.node.kind === 'table' && f.node.variant !== 'grid' }\nfunction isGrid(f) { return f.node.kind === 'table' && f.node.variant === 'grid' }\nfunction fragText(f) {\n  const n = f.node\n  if (n.kind === 'section') return n.title || '(без названия)'\n  if (n.kind === 'text') return (n.text || '').split('\\n')[0] || '(пусто)'\n  if (n.kind === 'table') {\n    if (n.variant === 'grid') {\n      const head = (n.headers || []).join(' | ')\n