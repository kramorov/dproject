            "content": "# proposals/management/commands/create_kp_template.py\n\"\"\"\nСоздать дефолтный .docx-шаблон коммерческого предложения.\n\nИспользование:\n    python manage.py create_kp_template\n\nШаблон — обычный Word-файл с Jinja2-тегами (docxtpl). После создания его можно\nоткрыть в Word и редактировать: менять логотип, шапку, цвета, вёрстку.\n\"\"\"\nfrom pathlib import Path\n\nfrom django.core.management.base import BaseCommand\nfrom docx import Document\nfrom docx.enum.text import WD_ALIGN_PARAGRAPH\nfrom docx.shared import Pt\n\n\nclass Command(BaseCommand):\n    help = 'Создать дефолтный шаблон КП (kp_template.docx).'\n\n    def handle(self, *args, **options):\n        doc = Document()\n\n        normal = doc.styles['Normal']\n        normal.font.name = 'Arial'\n        normal.font.size = Pt(11)\n\n        # ── Заголовок ──\n        title = doc.add_heading('Коммерческое предложение', 0)\n        title.alignment = WD_ALIGN_PARAGRAPH.CENTER\n\n        p = doc.add_paragraph()\n        p.alignment = WD_ALIGN_PARAGRAPH.CENTER\n        p.add_run('№ {{ number }} от {{ date }}').bold = True\n\n        doc.add_paragraph('Клиент: {{ customer }}')\n        doc.add_paragraph()\n\n        # ── Табличная часть ──\n        table = doc.add_table(rows=1, cols=6)\n        table.style = 'Table Grid'\n\n        headers = ['№ подпункта', 'Артикул', 'Описание', 'Количество', 'Цена, руб', 'Сумма, руб']\n        hdr_cells = table.rows[0].cells\n        for i, text in enumerate(headers):\n            hdr_cells[i].text = text\n            for run in hdr_cells[i].paragraphs[0].runs:\n                run.bold = True\n\n        # Строка-цикл (docxtpl {%tr %})\n        row = table.add_row().cells\n        row[0].text = '{%tr for item in items %}{{ item.n }}'\n        row[1].text = '{{ item.article }}'\n        row[2].text = '{{ item.description }}'\n        row[3].text = '{{ item.qty }}'\n        row[4].text = '{{ item.price }}'\n        row[5].text = '{{ item.sum }}{% endtr %}'\n\n        # Строка «Итого»\n        row = table.add_row().cells\n        merged = row[0]\n        for c in row[1:5]:\n            merged = merged.merge(c)\n        merged.text = 'Итого'\n        merged.paragraphs[0].runs[0].bold = True\n        total_cell = table.rows[-1].cells[5]\n        total_cell.text = '{{ total }}'\n        total_cell.paragraphs[0].runs[0].bold = True\n\n        doc.add_paragraph()\n\n        # ── Спецификации (описательная часть) ──\n        doc.add_heading('Спецификации', level=1)\n\n        doc.add_paragraph('{% for spec in specs %}')\n        doc.add_paragraph('{{ spec.article }} — {{ spec.name }}')\n        doc.add_paragraph('{% for row in spec.rows %}{{ row.label }}: {{ row.value }}\\n{% endfor %}')\n        doc.add_paragraph('{% endfor %}')\n\n        out = Path(__file__).resolve().parent.parent.parent / 'templates' / 'kp_template.docx'\n        out.parent.mkdir(parents=True, exist_ok=True)\n        doc.save(str(out))\n\n        self.stdout.write(self.style.SUCCESS(f'Template created: {out}'))\n",
