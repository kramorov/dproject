                "content": "\"\"\"\nconfigurator/tests/test_services.py\n\nТесты сервисов configurator на копии боевой базы.\n\nЗапуск:\n    python manage.py test configurator.tests.test_services --settings=configurator.tests.test_settings -v2\n\nИли через переменную окружения:\n    set DJANGO_SETTINGS_MODULE=configurator.tests.test_settings\n    python manage.py test configurator.tests.test_services -v2\n\"\"\"\nimport os\nimport sys\nfrom decimal import Decimal\n\nimport django\nfrom django.test import TestCase, TransactionTestCase\nfrom django.db import connection\n\n# ═══════════════════════════════════════════════════════════════════\n# Настройка: используем копию боевой базы\n# ═══════════════════════════════════════════════════════════════════\n\n# Переопределяем БД ДО django.setup()\n_test_db_path = os.path.join(\n    os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__)))),\n    'configurator_test_db.sqlite3'\n)\nos.environ.setdefault('DJANGO_SETTINGS_MODULE', 'djangoProject1.settings')\n\n# Проверяем, что тестовая БД существует\nif not os.path.exists(_test_db_path):\n    raise FileNotFoundError(\n        f\"Test database not found at {_test_db_path}. \"\n        f\"Run: Copy-Item db.sqlite3 configurator_test_db.sqlite3\"\n    )\n\n# Подменяем NAME в настройках на копию\nfrom django.conf import settings\nif not settings.configured:\n    settings.configure()\nsettings.DATABASES['default']['NAME'] = _test_db_path\nsettings.DATABASES['default']['TEST'] = {'NAME': _test_db_path}\n\n# Отключаем создание/удаление тестовой БД — работаем с копией как есть\n# Django TestCase по умолчанию оборачивает каждый тест в транзакцию и откатывает,\n# поэтому данные не пострадают.\n\ndjango.setup()\n\n# ═══════════════════════════════════════════════════════════════════\n# Импорты после django.setup()\n# ═══════════════════════════════════════════════════════════════════\n\nfrom core.models import EquipmentType\nfrom ai_assistant.models import CompositionGroup\nfrom configurator.models import (\n    AssemblyRequirements,\n    ComponentRequirement,\n    ParameterBinding,\n    ParameterRule,\n    PropagationRule,\n    DerivationRule,\n)\nfrom configurator.services.registry import (\n    get_product_model_class,\n    PRODUCT_MODEL_REGISTRY,\n)\nfrom configurator.services.expander import expand_composition_group\nfrom configurator.services.resolver import (\n    resolve_effective_requirements,\n    resolve_all_components,\n)\nfrom configurator.services.filter_engine import (\n    filter_by_requirements,\n    select_product,\n)\nfrom configurator.services.cascade import cascade_after_select\n\n\n# ═══════════════════════════════════════════════════════════════════\n# 1. Registry\n# ═══════════════════════════════════════════════════════════════════\n\nclass RegistryTest(TestCase):\n    \"\"\"Тесты реестра EquipmentType → Model.\"\"\"\n\n    def test_all_registered_types_resolve(self):\n        \"\"\"Все зарегистрированные коды должны разрешаться в модель.\"\"\"\n        for code in PRODUCT_MODEL_REGISTRY:\n            model_class = get_product_model_class(code)\n            self.assertIsNotNone(model_class, f\"Model for '{code}' is None\")\n            self.assertTrue(\n                model_class.__name__,\n                f\"Model for '{code}' has no __name__\",\n            )\n\n    def test_lsb_resolves_to_limitswitchbox(self):\n        \"\"\"lsb → LimitSwitchBox.\"\"\"\n        from pa_controls.models import LimitSwitchBox\n        model_class = get_product_model_class('lsb')\n        self.assertEqual(model_class, LimitSwitchBox)\n\n    def test_manual_override_resolves_to_gearbox(self):\n        \"\"\"manual-override → GearBox.\"\"\"\n        from gearbox.models.gearbox import GearBox\n        model_class = get_product_model_class('manual-override')\n        self.assertEqual(model_class, GearBox)\n\n    def test_unregistered_raises_keyerror(self):\n        \"\"\"Неизвестный код → KeyError.\"\"\"\n        with self.assertRaises(KeyError):\n            get_product_model_class('nonexistent-type')\n\n    def test_equipment_type_instance_resolves(self):\n        \"\"\"EquipmentType instance → model class.\"\"\"\n        et = EquipmentType.objects.get(code='lsb')\n        model_class = get_product_model_class(et)\n        self.assertIsNotNone(model_class)\n\n    def test_cache_returns_same_instance(self):\n        \"\"\"Повторный вызов возвращает тот же объект из кэша.\"\"\"\n        m1 = get_product_model_class('lsb')\n        m2 = get_product_model_class('lsb')\n        self.assertIs(m1, m2)\n\n\n# ═══════════════════════════════════════════════════════════════════\n# 2. Expander\n# ═══════════════════════════════════════════════════════════════════\n\nclass ExpanderTest(TestCase):\n    \"\"\"Тесты expand_composition_group().\"\"\"\n\n    def setUp(self):\n        self.cg_pa_kit = CompositionGroup.objects.get(code='pa-kit', is_active=True)\n\n    def test_expand_pa_kit_creates_components(self):\n        \"\"\"Разворачивание pa-kit создаёт ComponentRequirement.\"\"\"\n        assembly = AssemblyRequirements.objects.create(\n            composition_group=self.cg_pa_kit,\n            status='draft',\n        )\n        created = expand_composition_group(assembly)\n        self.assertGreater(len(created), 0, \"Should create at least one ComponentRequirement\")\n        self.assertEqual(\n            assembly.components.count(),\n            len(created),\n            \"Assembly.components count should match created list\",\n        )\n\n    def test_expand_sets_equipment_type(self):\n        \"\"\"Каждый CR должен иметь equipment_type (или быть виртуальным узлом).\"\"\"\n        assembly = AssemblyRequirements.objects.create(\n            composition_group=self.cg_pa_kit,\n            status='draft',\n        )\n        expand_composition_group(assembly)\n\n        for cr in assembly.components.all():\n            # Либо equipment_type, либо виртуальный узел (composition_group_node без ET)\n            self.assertTrue(\n                cr.equipment_type is not None or cr.composition_group_node is not None,\n                f\"CR #{cr.id} path={cr.path} has no equipment_type and no composition_group_node\",\n            )\n\n    def test_expand_creates_tree_structure(self):\n        \"\"\"Компоненты образуют дерево (parent, path, level).\"\"\"\n        assembly = AssemblyRequirements.objects.create(\n            composition_group=self.cg_pa_kit,\n            status='draft',\n        )\n        expand_composition_group(assembly)\n\n        roots = assembly.components.filter(parent__isnull=True)\n        self.assertGreater(roots.count(), 0, \"Should have at least one root component\")\n\n        children = assembly.components.filter(parent__isnull=False)\n        if children.exists():\n            sample = children.first()\n            self.assertIsNotNone(sample.parent, \"Child should have parent\")\n            self.assertIn(\n                str(sample.parent.id),\n                sample.path,\n                \"Child path should contain parent's id\",\n            )\n            self.assertGreater(sample.level, sample.parent.level,\n                               \"Child level should be greater than parent level\")\n\n    def test_expand_replaces_existing_components(self):\n        \"\"\"Повторный expand удаляет старые компоненты.\"\"\"\n        assembly = AssemblyRequirements.objects.create(\n            composition_group=self.cg_pa_kit,\n            status='draft',\n        )\n        first = expand_composition_group(assembly)\n        first_ids = {cr.id for cr in first}\n\n        second = expand_composition_group(assembly)\n        second_ids = {cr.id for cr in second}\n\n        # Все старые ID должны исчезнуть\n        self.assertFalse(\n            first_ids & second_ids,\n            \"Second expand should create new CRs, not reuse old ones\",\n        )\n\n    def test_expand_without_equipment_type_creates_virtual_nodes(self):\n        \"\"\"Узел CG без ET, но с дочерними группами → виртуальный CR.\"\"\"\n        # В pa-kit есть узел pa-choice-solenoid-positioner (xor) без ET\n        # но с дочерними directional-valve-options и positioner-kit-option\n        assembly = AssemblyRequirements.objects.create(\n            composition_group=self.cg_pa_kit,\n            status='draft',\n        )\n        expand_composition_group(assembly)\n\n        virtual_nodes = assembly.components.filter(equipment_type__isnull=True)\n        # Могут быть виртуальные узлы (зависит от структуры CG)\n        if virtual_nodes.exists():\n            vn = virtual_nodes.first()\n            self.assertIsNotNone(vn.composition_group_node,\n                                 \"Virtual node should have composition_group_node\")\n\n\n# ═══════════════════════════════════════════════════════════════════\n# 3. Resolver\n# ═══════════════════════════════════════════════════════════════════\n\nclass ResolverTest(TestCase):\n    \"\"\"Тесты resolve_effective_requirements.\"\"\"\n\n    def setUp(self):\n        self.cg_pa_kit = CompositionGroup.objects.get(code='pa-kit', is_active=True)\n        self.assembly = AssemblyRequirements.objects.create(\n            composition_group=self.cg_pa_kit,\n            global_requirements={'temp_min': -40, 'temp_max': 60, 'exd': 'Exd'},\n            status='draft',\n        )\n        expand_composition_group(self.assembly)\n\n    def test_resolve_without_propagation_rules(self):\n        \"\"\"Без PropagationRules effective = own_requirements (с трансляцией).\"\"\"\n        cr = self.assembly.components.filter(\n            equipment_type__isnull=False\n        ).first()\n        if not cr:\n            self.skipTest(\"No component with equipment_type in pa-kit\")\n\n        # Устанавливаем own_requirements\n        cr.own_requirements = {'ip_id': 5, 'work_temp_min': -20}\n        cr.save()\n\n        result = resolve_effective_requirements(cr)\n\n        # Должен быть непустой результат\n        self.assertIsInstance(result, dict)\n        self.assertGreater(len(result), 0, \"Should have at least some requirements\")\n\n    def test_resolve_key_translation(self):\n        \"\"\"Ключи own_requirements транслируются через FilterDefinition.\"\"\"\n        # Используем lsb, у которого есть FILTER_DEFINITIONS\n        et = EquipmentType.objects.get(code='lsb')\n        cr = ComponentRequirement.objects.create(\n            assembly=self.assembly,\n            equipment_type=et,\n            path='999',\n            level=1,\n            order=999,\n            own_requirements={'ip_id': 5, 'sensor_variety_id': 1},\n        )\n\n        result = resolve_effective_requirements(cr)\n\n        # Ключи должны быть транслированы: 'ip_id' → 'ip'\n        if 'ip' in result:\n            self.assertEqual(result['ip'], 5)\n        if 'ip_id' in result:\n            self.fail(\"Key 'ip_id' should be translated to 'ip', not left as-is\")\n        # model_field для sensor_variety\n        if result:\n            self.assertIsInstance(result, dict)\n\n    def test_resolve_with_cascade_params(self):\n        \"\"\"cascade_params добавляются в effective.\"\"\"\n        et = EquipmentType.objects.get(code='lsb')\n        cr = ComponentRequirement.objects.create(\n            assembly=self.assembly,\n            equipment_type=et,\n            path='998',\n            level=1,\n            order=998,\n            cascade_params={'connection_size': 'G1/4'},\n        )\n\n        result = resolve_effective_requirements(cr)\n        # cascade_params должны попасть в effective\n        self.assertIn('connection_size', result)\n        self.assertEqual(result['connection_size'], 'G1/4')\n\n    def test_resolve_skips_no_equipment_type(self):\n        \"\"\"CR без equipment_type → пустой effective.\"\"\"\n        cr = ComponentRequirement.objects.create(\n            assembly=self.assembly,\n            equipment_type=None,\n            path='997',\n            level=1,\n            order=997,\n        )\n        result = resolve_effective_requirements(cr)\n        self.assertEqual(result, {})\n\n    def test_resolve_all_components(self):\n        \"\"\"resolve_all_components обрабатывает все компоненты сборки.\"\"\"\n        self.assembly.global_requirements = {'temp_min': -60, 'pressure': 10}\n        self.assembly.save()\n\n        resolve_all_components(self.assembly)\n\n        for cr in self.assembly.components.filter(equipment_type__isnull=False):\n            self.assertIsNotNone(cr.effective_requirements,\n                                 f\"CR #{cr.id} should have effective_requirements\")\n\n\n# ═══════════════════════════════════════════════════════════════════\n# 4. FilterEngine\n# ═══════════════════════════════════════════════════════════════════\n\nclass FilterEngineTest(TestCase):\n    \"\"\"Тесты filter_by_requirements и select_product.\"\"\"\n\n    def setUp(self):\n        self.lsb_et = EquipmentType.objects.get(code='lsb')\n        self.assembly = AssemblyRequirements.objects.create(\n            composition_group=CompositionGroup.objects.get(code='pa-kit', is_active=True),\n            status='draft',\n        )\n        # Создаём CR для lsb с требованиями\n        self.cr = ComponentRequirement.objects.create(\n            assembly=self.assembly,\n            equipment_type=self.lsb_et,\n            path='1',\n            level=1,\n            order=1,\n            own_requirements={'ip_id': 5, 'work_temp_min': -20},\n        )\n\n    def test_filter_returns_candidates(self):\n        \"\"\"filter_by_requirements возвращает кандидатов для lsb.\"\"\"\n        resolve_effective_requirements(self.cr)\n        result = filter_by_requirements(self.cr)\n\n        self.assertIn('candidates', result)\n        self.assertIn('total', result)\n        self.assertIn('relaxed', result)\n        self.assertIsInstance(result['candidates'], list)\n\n        # С IP и температурой должно найти модели\n        self.assertGreater(result['total'], 0,\n                           \"Should find at least some LSB models with IP and temp filters\")\n\n    def test_filter_empty_effective_returns_empty(self):\n        \"\"\"Пустой effective → пустой результат.\"\"\"\n        self.cr.effective_requirements = {}\n        self.cr.save()\n        result = filter_by_requirements(self.cr)\n        self.assertEqual(result['total'], 0)\n        self.assertEqual(result['candidates'], [])\n\n    def test_filter_stores_results(self):\n        \"\"\"Результаты сохраняются в filter_results.\"\"\"\n        resolve_effective_requirements(self.cr)\n        filter_by_requirements(self.cr)\n\n        self.cr.refresh_from_db()\n        self.assertIsNotNone(self.cr.filter_results)\n        self.assertEqual(self.cr.status, 'filtered')\n\n    def test_select_product(self):\n        \"\"\"select_product выбирает продукт из кандидатов.\"\"\"\n        resolve_effective_requirements(self.cr)\n        filter_result = filter_by_requirements(self.cr)\n\n        if not filter_result['candidates']:\n            self.skipTest(\"No candidates found to select from\")\n\n        first_id = filter_result['candidates'][0]['id']\n        specs = select_product(self.cr, first_id)\n\n        self.assertIsNotNone(specs)\n        self.cr.refresh_from_db()\n        self.assertEqual(self.cr.status, 'selected')\n        self.assertEqual(self.cr.selected_product_id, first_id)\n        self.assertIsNotNone(self.cr.selected_product_type)\n        self.assertIn('LimitSwitchBox', self.cr.selected_product_type)\n\n    def test_select_nonexistent_product(self):\n        \"\"\"Выбор несуществующего продукта → пустой dict.\"\"\"\n        result = select_product(self.cr, 99999999)\n        self.assertEqual(result, {})\n\n    def test_filter_no_equipment_type_returns_empty(self):\n        \"\"\"CR без equipment_type → пустой результат.\"\"\"\n        cr = ComponentRequirement.objects.create(\n            assembly=self.assembly,\n            equipment_type=None,\n            path='999',\n            level=1,\n            order=999,\n        )\n        result = filter_by_requirements(cr)\n        self.assertEqual(result['total'], 0)\n\n    def test_filter_candidates_have_required_fields(self):\n        \"\"\"Каждый кандидат имеет id, name, code.\"\"\"\n        resolve_effective_requirements(self.cr)\n        result = filter_by_requirements(self.cr)\n\n        for candidate in result['candidates']:\n            self.assertIn('id', candidate)\n            self.assertIn('name', candidate)\n            self.assertIn('code', candidate)\n\n    def test_filter_with_multiple_hard_params(self):\n        \"\"\"Несколько hard-параметров фильтруют пересечение.\"\"\"\n        # ip + sensor_variety = оба hard\n        self.cr.own_requirements = {\n            'ip_id': 5,\n            'sensor_variety_id': 1,\n        }\n        self.cr.save()\n        resolve_effective_requirements(self.cr)\n        result = filter_by_requirements(self.cr)\n\n        self.assertIsInstance(result['candidates'], list)\n        self.assertGreaterEqual(result['total'], 0)\n\n    def test_relaxation_triggers_for_soft_params(self):\n        \"\"\"Если hard-фильтр дал 0 → включается релаксация.\"\"\"\n        # temperature_min = soft (step)\n        # Задаём невыполнимое требование\n        self.cr.own_requirements = {\n            'ip_id': 5,\n            'work_temp_min': -500,  # нет моделей с такой мин. температурой\n        }\n        self.cr.save()\n        resolve_effective_requirements(self.cr)\n        result = filter_by_requirements(self.cr)\n\n        # Должна сработать релаксация для temperature_min (soft)\n        if result['relaxed']:\n            self.assertGreater(result['total'], 0,\n                               \"Relaxation should find candidates\")\n            self.assertIn('relaxation_detail', result)\n            self.assertIn('step', result.get('relaxation_detail', ''))\n        else:\n            # Если релаксация не сработала — всё равно тест проходит,\n            # но логируем для отладки\n            print(f\"  Note: relaxation didn't trigger. \"\n                  f\"Hard filter found {result['total']} candidates. \"\n                  f\"Detail: {result.get('relaxation_detail', 'N/A')}\")\n\n\n# ═══════════════════════════════════════════════════════════════════\n# 5. Cascade\n# ═══════════════════════════════════════════════════════════════════\n\nclass CascadeTest(TestCase):\n    \"\"\"Тесты cascade_after_select.\"\"\"\n\n    def setUp(self):\n        self.lsb_et = EquipmentType.objects.get(code='lsb')\n        self.assembly = AssemblyRequirements.objects.create(\n            composition_group=CompositionGroup.objects.get(code='pa-kit', is_active=True),\n            status='draft',\n        )\n\n    def test_cascade_without_selection_returns_empty(self):\n        \"\"\"Без selected_product → пустой результат.\"\"\"\n        cr = ComponentRequirement.objects.create(\n            assembly=self.assembly,\n            equipment_type=self.lsb_et,\n            path='1',\n            level=1,\n            order=1,\n        )\n        result = cascade_after_select(cr)\n        self.assertEqual(result, {'derived_params': {}, 'fittings_created': 0})\n\n    def test_cascade_no_rules_returns_empty_dict(self):\n        \"\"\"Нет DerivationRules → derived_params пуст.\"\"\"\n        cr = ComponentRequirement.objects.create(\n            assembly=self.assembly,\n            equipment_type=self.lsb_et,\n            path='1',\n            level=1,\n            order=1,\n            selected_product_id=1,\n            selected_product_specs={'name': 'Test'},\n            selected_product_type='pa_controls.LimitSwitchBox',\n        )\n        result = cascade_after_select(cr)\n        self.assertEqual(result['derived_params'], {})\n        self.assertEqual(result['fittings_created'], 0)\n\n    def test_cascade_with_derivation_rule(self):\n        \"\"\"DerivationRule пробрасывает параметры в дочерние CR.\"\"\"\n        # Создаём тестовый DerivationRule\n        source_et = EquipmentType.objects.get(code='lsb')\n        # lsb → cable-gland cascade (резьба)\n        target_et = EquipmentType.objects.get(code='cable-gland')\n\n        rule = DerivationRule.objects.create(\n            code='test-lsb-thread',\n            source_type=source_et,\n            source_product_field='name',  # любое поле продукта\n            target_type=target_et,\n            target_param='thread_size',\n            is_active=True,\n        )\n\n        # Создаём родительский CR (lsb) с выбранным продуктом\n        parent_cr = ComponentRequirement.objects.create(\n            assembly=self.assembly,\n            equipment_type=source_et,\n            path='1',\n            level=1,\n            order=1,\n            selected_product_id=1,\n            selected_product_specs={'name': 'LSB-Test-Model'},\n            selected_product_type='pa_controls.LimitSwitchBox',\n        )\n\n        # Создаём дочерний CR (cable-gland)\n        child_cr = ComponentRequirement.objects.create(\n            assembly=self.assembly,\n            equipment_type=target_et,\n            parent=parent_cr,\n            path='1/1',\n            level=2,\n            order=2,\n            status='pending',\n        )\n\n        result = cascade_after_select(parent_cr)\n\n        # Должен пробросить name → thread_size\n        self.assertIn(child_cr.id, result['derived_params'])\n        child_cr.refresh_from_db()\n        self.assertIn('thread_size', child_cr.cascade_params or {})\n        self.assertEqual(\n            child_cr.cascade_params['thread_size'],\n            'LSB-Test-Model',\n        )\n\n        # Cleanup\n        rule.delete()\n\n    def test_cascade_condition_respected(self):\n        \"\"\"DerivationRule с condition проверяет specs.\"\"\"\n        source_et = EquipmentType.objects.get(code='lsb')\n        target_et = EquipmentType.objects.get(code='cable-gland')\n\n        rule = DerivationRule.objects.create(\n            code='test-lsb-conditional',\n            source_type=source_et,\n            source_product_field='name',\n            target_type=target_et,\n            target_param='thread_size',\n            condition={'field': 'name', 'value': 'SPECIAL'},\n            is_active=True,\n        )\n\n        parent_cr = ComponentRequirement.objects.create(\n            assembly=self.assembly,\n            equipment_type=source_et,\n            path='1',\n            level=1,\n            order=1,\n            selected_product_id=1,\n            selected_product_specs={'name': 'ORDINARY'},  # не совпадает с condition\n            selected_product_type='pa_controls.LimitSwitchBox',\n        )\n\n        child_cr = ComponentRequirement.objects.create(\n            assembly=self.assembly,\n            equipment_type=target_et,\n            parent=parent_cr,\n            path='1/1',\n            level=2,\n            order=2,\n            status='pending',\n        )\n\n        result = cascade_after_select(parent_cr)\n\n        # Condition не выполнен → параметры не должны проброситься\n        self.assertEqual(result['derived_params'], {},\n                         \"Condition not met, should not cascade\")\n\n        rule.delete()\n\n    def test_cascade_transform(self):\n        \"\"\"DerivationRule с transform применяет mapping.\"\"\"\n        source_et = EquipmentType.objects.get(code='lsb')\n        target_et = EquipmentType.objects.get(code='cable-gland')\n\n        rule = DerivationRule.objects.create(\n            code='test-lsb-transform',\n            source_type=source_et,\n            source_product_field='name',\n            target_type=target_et,\n            target_param='thread_size',\n            transform={'map': {'G1/4': '1/4', 'G1/2': '1/2'}},\n            is_active=True,\n        )\n\n        parent_cr = ComponentRequirement.objects.create(\n            assembly=self.assembly,\n            equipment_type=source_et,\n            path='1',\n            level=1,\n            order=1,\n            selected_product_id=1,\n            selected_product_specs={'name': 'G1/4'},\n            selected_product_type='pa_controls.LimitSwitchBox',\n        )\n\n        child_cr = ComponentRequirement.objects.create(\n            assembly=self.assembly,\n            equipment_type=target_et,\n            parent=parent_cr,\n            path='1/1',\n            level=2,\n            order=2,\n            status='pending',\n        )\n\n        result = cascade_after_select(parent_cr)\n\n        child_cr.refresh_from_db()\n        # G1/4 должно трансформироваться в 1/4\n        self.assertEqual(\n            child_cr.cascade_params.get('thread_size'),\n            '1/4',\n            \"Transform should map G1/4 → 1/4\",\n        )\n\n        rule.delete()\n",
