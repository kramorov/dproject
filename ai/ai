          "content": "<file path=\"configurator/services/filter_engine.py\" total_lines=\"540\" shown_lines=\"1-500\" truncated=\"true\" next_start_line=\"501\">\n     1│ \"\"\"\n     2│ configurator/services/filter_engine.py\n     3│ \n     4│ FilterEngine: требования → ParameterRule → Django Q → кандидаты.\n     5│ \n     6│ Использует существующий API из parameter_filter.py (_build_q_from_binding).\n     7│ \n     8│ Вызывается при подборе:\n     9│     filter_by_requirements(component)\n    10│     → component.filter_results = [candidates]\n    11│ \"\"\"\n    12│ from __future__ import annotations\n    13│ \n    14│ import logging\n    15│ from typing import Any\n    16│ \n    17│ from django.db.models import Q, Model, QuerySet\n    18│ \n    19│ from configurator.models import (\n    20│     ComponentRequirement,\n    21│     ParameterBinding,\n    22│ )\n    23│ from configurator.services.parameter_filter import _build_q_from_binding\n    24│ from configurator.services.registry import get_product_model_class\n    25│ \n    26│ logger = logging.getLogger(__name__)\n    27│ \n    28│ \n    29│ def filter_by_requirements(\n    30│     component: ComponentRequirement,\n    31│     max_results: int = 100,\n    32│ ) -> dict:\n    33│     \"\"\"\n    34│     Подбирает продукты по effective_requirements компонента.\n    35│ \n    36│     Для pneumatic-actuator — делегирует в PA selector\n    37│     (TorqueSelectorService + find_suitable_actuators).\n    38│     Для остальных типов — использует ParameterBinding/ParameterRule.\n    39│ \n    40│     Args:\n    41│         component: ComponentRequirement с заполненным effective_requirements.\n    42│         max_results: Максимальное количество кандидатов.\n    43│ \n    44│     Returns:\n    45│         {'candidates': [...], 'total': N, 'relaxed': bool, 'relaxation_detail': str}\n    46│     \"\"\"\n    47│     if not component.equipment_type:\n    48│         return _empty_result(\"No equipment_type\")\n    49│ \n    50│     # ── Спец-путь для пневмопривода: делегируем в PA selector ──\n    51│     if component.equipment_type.code == 'pneumatic-actuator':\n    52│         return _filter_pa_selector(component)\n    53│ \n    54│     effective = component.effective_requirements or {}\n    55│     if not effective:\n    56│         return _empty_result(\"No effective_requirements\")\n    57│ \n    58│     try:\n    59│         model_class = get_product_model_class(component.equipment_type)\n    60│     except KeyError as e:\n    61│         return _empty_result(str(e))\n    62│ \n    63│     # 1. Загружаем все ParameterBinding для этого типа\n    64│     bindings = _load_bindings(component.equipment_type)\n    65│ \n    66│     # 2. Разделяем параметры на hard и soft\n    67│     hard_q = Q()\n    68│     soft_params: list[tuple[ParameterBinding, Any, int]] = []\n    69│ \n    70│     for param_name, value in effective.items():\n    71│         binding = bindings.get(param_name)\n    72│         if not binding:\n    73│             continue  # параметр без привязанного прав\n\n---\n... [CONTENT TRUNCATED] ...\n---\n\n    config = rule.relaxation_config or {}\n   245│ \n   246│     if strategy == 'step':\n   247│         step = config.get('step', 1)\n   248│         max_steps = config.get('max_steps', 3)\n   249│         result = []\n   250│         try:\n   251│             val = float(value) if not isinstance(value, (int, float)) else value\n   252│             for s in range(1, max_steps + 1):\n   253│                 delta = step * s\n   254│                 # Для min-параметров (temperature_min): требование -20 → +5 → -15 (менее строго)\n   255│                 # Для max-параметров (temperature_max): требование +60 → -5 → +55 (менее строго)\n   256│                 direction = rule.match_config.get('direction', 'min')\n   257│                 if direction == 'min':\n   258│                     relaxed = val + delta  # ослабляем: -20 → -15 → -10\n   259│                 else:\