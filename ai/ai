              "type": "tool_result",
              "tool_use_id": "call_00_zkr3H9Tzi8iLurfJ6B079695",
              "content": "# ea_control/api.py\r\n\"\"\"\r\nAPI ea_control: CRUD моделей для фронт-админки + пакет конфигуратора БУ.\r\n\r\nЭндпоинты (под префиксом /api/ea-control/):\r\n\r\n- CRUD (DRF-роутер, IsAdminUser): control-units, sections, slots,\r\n  slot-options, matrix-entries, slot-rules, control-signal-forms,\r\n  feedback-signal-forms, control-signals, feedback-signals,\r\n  comm-protocols, feedback-devices, heater-supplies, location-options,\r\n  capabilities, local-control-types, display-types, signal-power-sources,\r\n  signal-powers, control-logics;\r\n- GET units/ — список типов БУ (id/code/name/kind/brand);\r\n- GET meta/ — справочники для селекторов (серии, напряжения, бренды, БУ,\r\n  режимы выбора, род значения);\r\n- GET series-units/?model_line=&power_supply= — доступные БУ серии\r\n  (резолвер слота control_unit);\r\n- GET package/?unit=&model_line=&power_supply=&mode=&locale= — пакет\r\n  конфигуратора (slots.md §5).\r\n\r\nПакет — серверный источник истины: доступность, дефолты и правила\r\nрезолвятся на бэке (ea_control.services).\r\n\"\"\"\r\nfrom django.shortcuts import get_object_or_404\r\nfrom django.db.models import Q\r\nfrom django.utils.translation import gettext_lazy as _\r\nfrom rest_framework import serializers, status, viewsets\r\nfrom rest_framework.decorators import action, api_view, permission_classes\r\nfrom rest_framework.pagination import PageNumberPagination\r\nfrom rest_framework.permissions import IsAdminUser\r\nfrom rest_framework.response import Response\r\n\r\nfrom ea_control.models import (CuCapability, CuCommProtocol, CuControlLogic,\r\n                               CuControlSignal, CuControlSignalForm,\r\n                               CuDisplayType, CuFeedbackDevice,\r\n                               CuFeedbackSignal, CuFeedbackSignalForm,\r\n                               CuHeaterSupply, CuLocalControlType,\r\n                               CuLocationOption, CuMatrixEntry, CuSignalPower,\r\n                               CuSignalPowerSource, CuSlot, CuSlotOption,\r\n                               CuSlotRule, CuUnitPowerSource, ControlUnit,\r\n                               ControlUnitKind, CuSectionNode, CuSlotSource,\r\n                               SLOT_SOURCE_PAYLOAD)\r\nfrom ea_control.services.cu_matrix import resolve_control_units\r\nfrom ea_control.services.cu_package import build_package\r\nfrom ea_control.services.cu_report import build_description\r\nfrom ea_control.services.cu_unit_matrix import (MatrixValidationError,\r\n                                                 apply_unit_matrix_changes,\r\n                                                 apply_unit_rule_changes,\r\n                                                 build_unit_matrix)\r\n\r\n\r\nclass _LargePagination(PageNumberPagination):\r\n    \"\"\"Админ-таблицы: без жёсткого лимита страницы по умолчанию.\"\"\"\r\n    page_size = 1000\r\n\r\n\r\ndef _clean_via_model(instance, model_cls, attrs, extra_fields=()):\r\n    \"\"\"Прогнать model.clean() для API-пути (DRF full_clean не вызывает).\r\n\r\n    Недостающие для проверки поля подставляются из редактируемого\r\n    экземпляра; M2M исключаются (их clean проверяет только при pk).\r\n    \"\"\"\r\n    from django.core.exceptions import ValidationError as DjValidationError\r\n    m2m = {f.name for f in model_cls._meta.many_to_many}\r\n    probe_kwargs = {k: v for k, v in attrs.items() if k not in m2m}\r\n    if instance is not None:\r\n        for f in extra_fields:\r\n            if f not in probe_kwargs:\r\n                val = getattr(instance, f)\r\n                if val is not None:\r\n                    probe_kwargs[f] = val\r\n    probe = model_cls(**probe_kwargs)\r\n    try:\r\n        probe.clean()\r\n    except DjValidationError as exc:\r\n        raise serializers.ValidationError(\r\n            exc.message_dict if hasattr(exc, 'message_dict')\r\n            else {'non_field_errors': exc.messages})\r\n\r\n\r\ndef _serializer(model_cls):\r\n    \"\"\"ModelSerializer «все поля» для модели (фронт-админка).\"\"\"\r\n    class S(serializers.ModelSerializer):\r\n        class Meta:\r\n            model = model_cls\r\n            fields = '__all__'\r\n            # i18n синхронизируется миксином из name/description (только ru);\r\n            # полный PUT без этих полей не должен сбрасывать переводы en/cn.\r\n            read_only_fields = ('name_i18n', 'description_i18n', 'key')\r\n    S.__name__ = f'{model_cls.__name__}Serializer'\r\n    return S\r\n\r\n\r\ndef _viewset(model_cls, serializer_cls):\r\n    \"\"\"ModelViewSet с IsAdminUser и крупной страницей.\"\"\"\r\n    class V(viewsets.ModelViewSet):\r\n        queryset = model_cls.objects.all()\r\n        serializer_class = serializer_cls\r\n        permission_classes = [IsAdminUser]\r\n        pagination_class = _LargePagination\r\n    V.__name__ = f'{model_cls.__name__}ViewSet'\r\n    return V\r\n\r\n\r\ndef _guarded_delete_viewset(model_cls, serializer_cls, usage_specs):\r\n    \"\"\"ModelViewSet, у которого DELETE не блокируется защитой FK.\r\n\r\n    ``usage_specs`` — список (label, count_qs_fn, cascade_fn):\r\n    count_qs_fn(obj) → QuerySet зависимых строк (для отчёта), cascade_fn(obj)\r\n    удаляет их при подтверждении (?cascade=1); None — зависимость удаляется\r\n    сама (FK с on_delete=CASCADE).\r\n\r\n    Без ?cascade=1 при наличии зависимостей возвращается 409 с перечнем\r\n    ``usage`` — фронт спрашивает «данные используются в …, удалить?» и\r\n    повторяет DELETE с ?cascade=1.\r\n    \"\"\"\r\n    base = _viewset(model_cls, serializer_cls)\r\n\r\n    class V(base):\r\n        def destroy(self, request, *args, **kwargs):\r\n            obj = self.get_object()\r\n            force = request.query_params.get('cascade') in ('1', 'true', 'yes')\r\n            usage = []\r\n            for label, count_qs, _cascade_fn in usage_specs:\r\n                count = count_qs(obj).count()\r\n                if count:\r\n                    usage.append({'label': str(label), 'count': count})\r\n            if usage and not force:\r\n                return Response(\r\n                    {'detail': _('Объект используется. '\r\n                                 'Удалить вместе с зависимыми данными?'),\r\n                     'usage': usage,\r\n                     'cascade_url': request.path + '?cascade=1'},\r\n                    status=status.HTTP_409_CONFLICT)\r\n            if force:\r\n                for _label, _count_qs, cascade_fn in usage_specs:\r\n                    if cascade_fn:\r\n                        cascade_fn(obj)\r\n            self.perform_destroy(obj)\r\n            return Response(status=status.HTTP_204_NO_CONTENT)\r\n\r\n    V.__name__ = f'{model_cls.__name__}ViewSet'\r\n    return V\r\n\r\n\r\ndef _slot_usage_specs():\r\n    \"\"\"Слот: блокируют строки матрицы (PROTECT); опции и правила каскадят сами.\"\"\"\r\n    def matrix(o):\r\n        return CuMatrixEntry.objects.filter(slot=o)\r\n\r\n    return [\r\n        (_('строки матрицы'), matrix, lambda o: matrix(o).delete()),\r\n        (_('опции слота'), lambda o: CuSlotOption.objects.filter(slot=o), None),\r\n        (_('правила'),\r\n         lambda o: CuSlotRule.objects.filter(Q(when_slot=o) | Q(target_slot=o)),\r\n         None),\r\n    ]\r\n\r\n\r\ndef _option_usage_specs():\r\n    \"\"\"Опция: строки матрицы со ссылкой на неё (SET_NULL) — при подтверждении\r\n    удаляются вместе с опцией (без опции строки бесполезны).\"\"\"\r\n    def matrix(o):\r\n        return CuMatrixEntry.objects.filter(option=o)\r\n\r\n    return [\r\n        (_('строки матрицы'), matrix, lambda o: matrix(o).delete()),\r\n    ]\r\n\r\n\r\ndef _node_usage_specs():\r\n    \"\"\"Узел: слоты всей ветки (SET_NULL) — при подтверждении удаляются вместе\r\n    со своими строками матрицы; вложенные узлы каскадят сами (CASCADE).\"\"\"\r\n\r\n    def _subtree_ids(root_id):\r\n        ids = [root_id]\r\n        frontier = [root_id]\r\n        while frontier:\r\n            children = list(\r\n                CuSectionNode.objects.filter(parent_id__in=frontier)\r\n                .values_list('id', flat=True))\r\n            ids.extend(children)\r\n            frontier = children\r\n        return ids\r\n\r\n    def slots(o):\r\n        return CuSlot.objects.filter(section_id__in=_subtree_ids(o.id))\r\n\r\n    def cascade(o):\r\n        for slot in slots(o):\r\n            CuMatrixEntry.objects.filter(slot=slot).delete()\r\n            slot.delete()\r\n\r\n    return [\r\n        (_('слоты'), slots, cascade),\r\n        (_('вложенные узлы'),\r\n         lambda o: CuSectionNode.objects.filter(parent=o), None),\r\n    ]\r\n\r\n\r\ndef _delete_options_with_matrix(options_qs):\r\n    \"\"\"Удалить опции слотов вместе со строками матрицы, ссылающимися на них.\"\"\"\r\n    ids = list(options_qs.values_list('id', flat=True))\r\n    if ids:\r\n        CuMatrixEntry.objects.filter(option_id__in=ids).delete()\r\n    options_qs.delete()\r\n\r\n\r\ndef _delete_signal_power_rows(pairs_qs):\r\n    \"\"\"Удалить схемы цепей вместе с опциями и строками матрицы по ним.\"\"\"\r\n    ids = list(pairs_qs.values_list('id', flat=True))\r\n    if ids:\r\n        opt_ids = list(CuSlotOption.objects.filter(signal_power_id__in=ids)\r\n                       .values_list('id', flat=True))\r\n        if opt_ids:\r\n            CuMatrixEntry.objects.filter(option_id__in=opt_ids).delete()\r\n        CuSlotOption.objects.filter(signal_power_id__in=ids).delete()\r\n        CuMatrixEntry.objects.filter(signal_power_id__in=ids).delete()\r\n    pairs_qs.delete()\r\n\r\n\r\ndef _delete_signal_rows(signals_qs, field):\r\n    \"\"\"Удалить сигналы вместе с опциями и строками матрицы, ссылающимися по\r\n    полю ``field`` ('control_signal'/'feedback_signal').\"\"\"\r\n    ids = list(signals_qs.values_list('id', flat=True))\r\n    if ids:\r\n        kw = {field + '_id__in': ids}\r\n        opt_ids = list(CuSlotOption.objects.filter(**kw)\r\n                       .values_list('id', flat=True))\r\n        if opt_ids:\r\n            CuMatrixEntry.objects.filter(option_id__in=opt_ids).delete()\r\n        CuSlotOption.objects.filter(**kw).delete()\r\n        CuMatrixEntry.objects.filter(**kw).delete()\r\n    signals_qs.delete()\r\n\r\n\r\ndef _ref_usage_specs(option_field=None, matrix_field=None, extra_specs=None):\r\n    \"\"\"Usage-спеки для справочников физики: опции слотов и строки матрицы,\r\n    ссылающиеся на справочник по option_field/matrix_field (+extra_specs).\"\"\"\r\n    specs = []\r\n    if option_field:\r\n        def options(o, _f=option_field):\r\n            return CuSlotOption.objects.filter(**{_f: o})\r\n        specs.append((_('опции слотов'), options,\r\n                      lambda o: _delete_options_with_matrix(options(o))))\r\n    if matrix_field:\r\n        def rows(o, _f=matrix_field):\r\n            return CuMatrixEntry.objects.filter(**{_f: o})\r\n        specs.append((_('строки матрицы'), rows, lambda o: rows(o).delete()))\r\n    if extra_specs:\r\n        specs.extend(extra_specs)\r\n    return specs\r\n\r\n\r\ndef _ctl_form_extra_specs():\r\n    def pairs(o):\r\n        return CuSignalPower.objects.filter(input_form=o)\r\n\r\n    def signals(o):\r\n        return CuControlSignal.objects.filter(form=o)\r\n\r\n    return [\r\n        (_('схемы цепей'), pairs,\r\n         lambda o: _delete_signal_power_rows(pairs(o))),\r\n        (_('командные сигналы'), signals,\r\n         lambda o: _delete_signal_rows(signals(o), 'control_signal')),\r\n    ]\r\n\r\n\r\ndef _fb_form_extra_specs():\r\n    def signals(o):\r\n        return CuFeedbackSignal.objects.filter(form=o)\r\n\r\n    return [\r\n        (_('сигналы ОС'), signals,\r\n         lambda o: _delete_signal_rows(signals(o), 'feedback_signal')),\r\n    ]\r\n\r\n\r\ndef _sp_source_usage_specs():\r\n    def pairs(o):\r\n        return CuSignalPower.objects.filter(source=o)\r\n\r\n    return [\r\n        (_('схемы цепей'), pairs,\r\n         lambda o: _delete_signal_power_rows(pairs(o))),\r\n    ]\r\n\r\n\r\ndef _slot_serializer():\r\n    \"\"\"CuSlot + model.clean() (object обязан объявить источник и т.п.).\"\"\"\r\n    class S(serializers.ModelSerializer):\r\n        class Meta:\r\n            model = CuSlot\r\n            fields = '__all__'\r\n            read_only_fields = ('name_i18n', 'description_i18n', 'key')\r\n\r\n        def validate(self, attrs):\r\n            _clean_via_model(self.instance, CuSlot, attrs,\r\n                             ('code', 'name', 'slot_kind', 'source'))\r\n            return attrs\r\n\r\n    S.__name__ = 'CuSlotSerializer'\r\n    return S\r\n\r\n\r\ndef _slot_option_serializer():\r\n    \"\"\"CuSlotOption + валидация «display-опция без видов отображения».\r\n\r\n    model.clean() для M2M не надёжен (см. cu_config.py) — проверяем здесь,\r\n    чтобы API-путь фронта не мог сохранить пустую display-опцию.\r\n    \"\"\"\r\n    class S(serializers.ModelSerializer):\r\n        class Meta:\r\n            model = CuSlotOption\r\n            fields = '__all__'\r\n            read_only_fields = ('name_i18n', 'description_i18n', 'key')\r\n\r\n        def validate(self, attrs):\r\n            # object-слот: kind опции определяется источником слота\r\n            slot = attrs.get('slot', getattr(self.instance, 'slot', None))\r\n            src = getattr(slot, 'source', '') if slot is not None else ''\r\n            if src:\r\n                expected_kind, _field = SLOT_SOURCE_PAYLOAD.get(src, (None, None))\r\n                kind = attrs.get('kind', getattr(self.instance, 'kind', None))\r\n                if not kind and expected_kind:\r\n                    attrs['kind'] = expected_kind\r\n                elif kind and expected_kind and kind != expected_kind \\\r\n                        and kind != 'none':\r\n                    raise serializers.ValidationError(\r\n                        {'kind': _('Слот «%(slot)s» (источник %(src)s): у опции '\r\n                                   'должен быть kind=%(kind)s (или none).')\r\n                         % {'slot': slot.code, 'src': src,\r\n                            'kind': expected_kind}})\r\n            kind = attrs.get('kind', getattr(self.instance, 'kind', None))\r\n            if kind == 'display':\r\n                if 'display_types' in attrs:\r\n                    types = attrs.get('display_types') or []\r\n                elif self.instance and self.instance.pk:\r\n                    types = list(self.instance.display_types.all())\r\n                else:\r\n                    types = []\r\n                if not types:\r\n                    raise serializers.ValidationError(\r\n                        {'display_types': _('Для опции отображения нужен '\r\n                                            'хотя бы один вид отображения.')})\r\n            # источник: правила model.clean() должны действовать и через API\r\n            _clean_via_model(self.instance, CuSlotOption, attrs,\r\n                             _OPT_CLEAN_FIELDS)\r\n            return attrs\r\n\r\n    S.__name__ = 'CuSlotOptionSerializer'\r\n    return S\r\n\r\n\r\n_OPT_CLEAN_FIELDS = (\r\n    'code', 'name', 'slot', 'kind', 'control_signal', 'feedback_signal',\r\n    'protocol', 'heater_supply', 'signal_power', 'control_logic',\r\n    'control_unit', 'device', 'local_control_type', 'unit_power_source',\r\n    'cable_gland_set', 'location_option', 'access_device_option',\r\n)\r\n\r\n\r\ndef _control_unit_serializer():\r\n    \"\"\"ControlUnit: ``key`` — неизменяемый стабильный ключ (read-only).\r\n\r\n    Заполняется в ``ControlUnit.save()`` из ``code`` при создании и больше\r\n    не меняется; фронт не должен его писать.\r\n    \"\"\"\r\n    class S(serializers.ModelSerializer):\r\n        class Meta:\r\n            model = ControlUnit\r\n            fields = '__all__'\r\n            read_only_fields = ('name_i18n', 'description_i18n', 'key')\r\n    S.__name__ = 'ControlUnitSerializer'\r\n    return S\r\n\r\n\r\n# ── CRUD-вьюсеты (регистрируются в urls.py роутером) ────────────────────────\r\n\r\n\r\nclass ControlUnitViewSet(viewsets.ModelViewSet):\r\n    \"\"\"Типы БУ + копирование (с матрицей/правилами) и удаление с очисткой.\"\"\"\r\n    queryset = ControlUnit.objects.all().order_by('brand', 'sorting_order', 'code')\r\n    serializer_class = _control_unit_serializer()\r\n    permission_classes = [IsAdminUser]\r\n    pagination_class = _LargePagination\r\n\r\n    @action(detail=True, methods=['post'])\r\n    def copy(self, request, pk=None):\r\n        \"\"\"Копия БУ: скаляры + M2M + опция слота control_unit +\r\n        профильные строки матрицы + правила, завязанные на код опции.\"\"\"\r\n        unit = get_object_or_404(ControlUnit, pk=pk)\r\n        base = unit.code\r\n        n = 1\r\n        code = f'{base}-cp{n}'\r\n        while ControlUnit.objects.filter(brand=unit.brand, code=code).exists():\r\n            n += 1\r\n            code = f'{base}-cp{n}'\r\n        new = ControlUnit.objects.create(\r\n            brand=unit.brand, code=code, name=unit.name,\r\n            kind=unit.kind,\r\n            name_template=unit.name_template,\r\n            description_template=unit.description_template,\r\n            spec_template=unit.spec_template,\r\n            name_template_i18n=unit.name_template_i18n,\r\n            description_template_i18n=unit.description_template_i18n,\r\n            description=unit.description,\r\n            sorting_order=(unit.sorting_order or 0) + 1, is_active=unit.is_active)\r\n        # имя «(копия)» без перегенерации шаблоном (TemplateMixin.save)\r\n        new.name = f'{unit.name} (копия)'\r\n        new.description = unit.description\r\n        new.save(skip_auto_generate=True)\r\n        new.accepts.set(unit.accepts.all())\r\n        new.emits.set(unit.emits.all())\r\n        new.protocols.set(unit.protocols.all())\r\n        new.capabilities.set(unit.capabilities.all())\r\n\r\n        # опция слота control_unit для копии (коды опций глобально уникальны)\r\n        old_opt = CuSlotOption.objects.filter(\r\n            slot__code='control_unit', control_unit=unit).first()\r\n        new_opt = None\r\n        if old_opt:\r\n            m = 1\r\n            opt_code = f'{old_opt.code}_CP{m}'\r\n            while CuSlotOption.objects.filter(code=opt_code).exists():\r\n                m += 1\r\n                opt_code = f'{old_opt.code}_CP{m}'\r\n            new_opt = CuSlotOption.objects.create(\r\n                code=opt_code, slot=old_opt.slot, kind='unit',\r\n                control_unit=new, encoding=old_opt.encoding,\r\n                ext_encoding=old_opt.ext_encoding,\r\n                sorting_order=old_opt.sorting_order, is_active=old_opt.is_active)\r\n\r\n        # профильные строки матрицы (control_unit → копия) + конфликты\r\n        old_rows = list(CuMatrixEntry.objects.filter(control_unit=unit))\r\n        id_map = {}\r\n        for r in old_rows:\r\n            nr = CuMatrixEntry.objects.create(\r\n                slot=r.slot, option=r.option, brand=r.brand,\r\n                model_line=r.model_line, body=r.body,\r\n                model_line_item=r.model_line_item, control_unit=new,\r\n                power_supply=r.power_supply, signal_power=r.signal_power,\r\n                mode=r.mode,\r\n                control_signal=r.control_signal, feedback_signal=r.feedback_signal,\r\n                protocol=r.protocol, device=r.device,\r\n                heater_supply=r.heater_supply, availability=r.availability,\r\n                is_default=r.is_default, bundle=r.bundle,\r\n                encoding=r.encoding, ext_encoding=r.ext_encoding,\r\n                name=r.name, description=r.description,\r\n                sorting_order=r.sorting_order)\r\n            id_map[r.id] = nr\r\n        for r in old_rows:\r\n            for c in r.conflicts.all():\r\n                if c.id in id_map:\r\n                    id_map[r.id].conflicts.add(id_map[c.id])\r\n\r\n        # правила, завязанные на код опции выбора БУ (в т.ч. списки — 'in')\r\n        def _remap(value):\r\n            if value == old_opt.code:\r\n                return (new_opt.code if new_opt else None), True\r\n            if isinstance(value, list) and old_opt.code in value:\r\n                out = [(new_opt.code if x == old_opt.code else x)\r\n                       for x in value]\r\n                if new_opt is None:\r\n                    out = [x for x in out if x is not None]\r\n                return out, True\r\n            return value, False\r\n\r\n        if old_opt:\r\n            for rule in CuSlotRule.objects.filter(\r\n                    when_slot__code='control_unit'):\r\n                wv, c1 = _remap(rule.when_value)\r\n                av, c2 = _remap(rule.action_value)\r\n                if c1 or c2:\r\n                    CuSlotRule.objects.create(\r\n                        when_slot=rule.when_slot, target_slot=rule.target_slot,\r\n                        when_operator=rule.when_operator, when_value=wv,\r\n                        action=rule.action, action_value=av,\r\n                        priority=rule.priority, is_active=rule.is_active,\r\n                        description=rule.description)\r\n        return Response({'id': new.id, 'code': new.code}, status=201)\r\n\r\n    @action(detail=True, methods=['delete'], url_path='delete-unit')\r\n    def delete_unit(self, request, pk=None):\r\n        \"\"\"Удаление БУ: опция слота control_unit (PROTECT) снимается,\r\n        связанные правила чистятся, профильные строки матрицы — каскадом.\"\"\"\r\n        unit = get_object_or_404(ControlUnit, pk=pk)\r\n        opts = list(CuSlotOption.objects.filter(\r\n            slot__code='control_unit', control_unit=unit))\r\n        for o in opts:\r\n            # exact-правила\r\n            CuSlotRule.objects.filter(\r\n                Q(when_slot__code='control_unit', when_value=o.code)\r\n                | Q(action_value=o.code)).delete()\r\n            # правила со списками (оператор in/not_in): убрать код из списка\r\n            for rule in CuSlotRule.objects.filter(\r\n                    when_slot__code='control_unit'):\r\n                wv, av = rule.when_value, rule.action_value\r\n                changed = False\r\n                if isinstance(wv, list) and o.code in wv:\r\n                    wv = [x for x in wv if x != o.code]\r\n                    changed = True\r\n                if isinstance(av, list) and o.code in av:\r\n                    av = [x for x in av if x != o.code]\r\n                    changed = True\r\n                if changed:\r\n                    rule.when_value = wv\r\n                    rule.action_value = av\r\n                    rule.save(update_fields=['when_value', 'action_value'])\r\n            o.delete()\r\n        unit.delete()\r\n        return Response(status=204)\r\nCuSectionNodeViewSet = _guarded_delete_viewset(\r\n    CuSectionNode, _serializer(CuSectionNode), _node_usage_specs())\r\nCuSlotViewSet = _guarded_delete_viewset(\r\n    CuSlot, _slot_serializer(), _slot_usage_specs())\r\nCuSlotOptionViewSet = _guarded_delete_viewset(\r\n    CuSlotOption, _slot_option_serializer(), _option_usage_specs())\r\nCuMatrixEntryViewSet = _viewset(CuMatrixEntry, _serializer(CuMatrixEntry))\r\nCuSlotRuleViewSet = _viewset(CuSlotRule, _serializer(CuSlotRule))\r\nCuControlSignalFormViewSet = _guarded_delete_viewset(\r\n    CuControlSignalForm, _serializer(CuControlSignalForm),\r\n    _ref_usage_specs(extra_specs=_ctl_form_extra_specs()))\r\nCuFeedbackSignalFormViewSet = _guarded_delete_viewset(\r\n    CuFeedbackSignalForm, _serializer(CuFeedbackSignalForm),\r\n    _ref_usage_specs(extra_specs=_fb_form_extra_specs()))\r\nCuControlSignalViewSet = _guarded_delete_viewset(\r\n    CuControlSignal, _serializer(CuControlSignal),\r\n    _ref_usage_specs('control_signal', 'control_signal'))\r\nCuFeedbackSignalViewSet = _guarded_delete_viewset(\r\n    CuFeedbackSignal, _serializer(CuFeedbackSignal),\r\n    _ref_usage_specs('feedback_signal', 'feedback_signal'))\r\nCuCommProtocolViewSet = _guarded_delete_viewset(\r\n    CuCommProtocol, _serializer(CuCommProtocol),\r\n    _ref_usage_specs('protocol', 'protocol'))\r\nCuFeedbackDeviceViewSet = _guarded_delete_viewset(\r\n    CuFeedbackDevice, _serializer(CuFeedbackDevice),\r\n    _ref_usage_specs('device', 'device'))\r\nCuHeaterSupplyViewSet = _viewset(CuHeaterSupply, _serializer(CuHeaterSupply))\r\nCuLocationOptionViewSet = _viewset(CuLocationOption, _serializer(CuLocationOption))\r\nCuCapabilityViewSet = _viewset(CuCapability, _serializer(CuCapability))\r\nCuLocalControlTypeViewSet = _viewset(CuLocalControlType,\r\n                                     _serializer(CuLocalControlType))\r\nCuDisplayTypeViewSet = _viewset(CuDisplayType, _serializer(CuDisplayType))\r\nCuUnitPowerSourceViewSet = _viewset(CuUnitPowerSource,\r\n                                    _serializer(CuUnitPowerSource))\r\nCuSignalPowerSourceViewSet = _guarded_delete_viewset(\r\n    CuSignalPowerSource, _serializer(CuSignalPowerSource),\r\n    _sp_source_usage_specs())\r\nCuSignalPowerViewSet = _guarded_delete_viewset(\r\n    CuSignalPower, _serializer(CuSignalPower),\r\n    _ref_usage_specs('signal_power', 'signal_power'))\r\nCuControlLogicViewSet = _viewset(CuControlLogic, _serializer(CuControlLogic))\r\n\r\n# Общие справочники ЭП, используемые и БУ (kind/technology устройств ОС).\r\nfrom electric_actuators.models import (EaFeedbackDeviceKind,  # noqa: E402\r\n                                       EaFeedbackTechnology,\r\n                                       EaAccessDeviceOption,\r\n                                       EaSignalFormCategory,\r\n                                       EaControlSignalRole,\r\n                                       EaFeedbackSignalRole,\r\n                                       EaContactNormal,\r\n                                       EaProtocolTransport)\r\nfrom ea_control.models.cu_power import CuPolarity  # noqa: E