ffective_requirements.items():\n   355│         binding = ParameterBinding.objects.get(\n   356│             equipment_type=component.equipment_type,\n   357│             param_name=param_name,\n   358│         )\n   359│         rule = binding.rule\n   360│         if rule.hardness == 'hard':\n   361│             hard_params.append((rule, value))\n   362│         else:\n   363│             soft_params.append((rule, value, binding.priority))\n   364│ \n   365│     # 2. HARD FILTER\n   366│     hard_q = Q()\n   367│     for rule, value in hard_params:\n   368│         hard_q &= build_q_from_parameter_rule(rule, value, model_class)\n   369│ \n   370│     candidates = model_class.objects.filter(hard_q, is_active=True)\n   371│ \n   372│     # 3. RELAX — если кандидатов нет\n   373│     relaxed = False\n   374│     if not candidates.exists():\n   375│         candidates, relaxed = relax_and_filter(\n   376│             soft_params, hard_q, model_class\n   377│         )\n   378│ \n   379│     # 4. SCORE\n   380│     scored = score_candidates(candidates, soft_params)\n   381│ \n   382│     return {\n   383│         'candidates': [c.to_dict() for c in scored],\n   384│         'total': len(scored),\n   385│         'relaxed': relaxed,\n   386│     }\n   387│ ```\n   388│ \n   389│ ### build_q_from_parameter_rule\n   390│ \n   391│ Преобразует `ParameterRule.match_type` в Django Q-lookup —\n   392│ заменяет хардкод `FilterType`:\n   393│ \n   394│ | FilterType (каталоги) | ParameterRule.match_type | Django lookup |\n   395│ |---|---|---|\n   396│ | `EXACT` | `exact` | `field=value` |\n   397│ | `TEMP_MIN` | `directional`, `direction=min` | `field__lte=value` |\n   398│ | `TEMP_MAX` | `directional`, `direction=max` | `field__gte=value` |\n   399│ | `IP_RANK` | `subset` | `field__ip_rank__gte=rank(value)` |\n   400│ | `EXD_COMPATIBLE` | `hierarchy` | `field__in=compatible_ids(value)` |\n   401│ | — | `compatible` | `field__in=compatible_group(value)` |\n   402│ \n   403│ ---\n   404│ \n   405│ ## API endpoints\n   406│ \n   407│ Базовый URL: `/api/configurator/`\n   408│ \n   409│ ### Сборки\n   410│ \n   411│ | Endpoint | Метод | Назначение |\n   412│ |---|---|---|\n   413│ | `/assemblies/` | POST | Создать сборку (composition_group_id) |\n   414│ | `/assemblies/{id}/` | GET | Получить сборку с деревом компонентов |\n   415│ | `/assemblies/{id}/` | PATCH | Обновить global_requirements |\n   416│ | `/assemblies/{id}/expand/` | POST | Развернуть CompositionGroup → дерево CR |\n   417│ | `/assemblies/{id}/bom/` | GET | MBOM/EBOM: дерево выбранных продуктов |\n   418│ \n   419│ ### Компоненты\n   420│ \n   421│ | Endpoint | Метод | Назначение |\n   422│ |---|---|---|\n   423│ | `/components/{id}/` | GET | Состояние компонента |\n   424│ | `/components/{id}/requirements/` | PATCH | own_requirements → resolve effective |\n   425│ | `/components/{id}/filter/` | POST | Запустить FilterEngine |\n   426│ | `/components/{id}/select/` | POST | Выбрать продукт → cascade |\n   427│ \n   428│ ### Схема формы\n   429│ \n   430│ | Endpoint | Метод | Назначение |\n   431│ |---|---|---|\n   432│ | `/equipment-types/{id}/filter-schema/` | GET | FilterDefinition + опции для формы требований |\n   433│ \n   434│ ---\n   435│ \n   436│ ## Фронт: страница конфигуратора\n   437│ \n   438│ Страница `/configurator/pa-kit` — копия-развитие `PaSelectionPage.vue`:\n   439│ \n   440│ ```\n   441│ ┌─ Левая панель (дерево) ─────┐  ┌─ Правая (детали) ───────────────────┐\n   442│ │                              │  │                                      │\n   443│ │ ☑ Пневмопривод    [выбран]  │  │ Требования к приводу                 │\n   444│ │ ☐ Соленоид                  │  │ ┌──────────────────────────────────┐ │\n   445│ │ ☐ БКВ                       │  │ │ Момент: [150] Нм                  │ │\n   446│ │ ☐ Фильтр-регулятор          │  │ │ Тип:    [DA ▾]                   │ │\n   447│ │ ☐ Фитинги                   │  │ │ Temp:   [-40]…[+60] ← global     │ │\n   44