ton class=\"tool\" :class=\"magnifierOn ? 'active' : ''\" @click=\"magnifierOn = !magnifierOn\">🔍 Лупа</button>\n        <span v-if=\"selMode\" class=\"hint\">{{ selHint }}</span>\n      </div>\n\n      <!-- справа: холст -->\n      <aside class=\"canvas-pane\">\n        <div v-if=\"error\" class=\"error\">{{ error }}</div>\n\n        <div class=\"row-actions\">\n          <button class=\"btn\" @click=\"copyJSON\">📋 JSON</button>\n          <button class=\"btn\" @click=\"downloadJSON\">💾 JSON</button>\n          <button class=\"btn\" @click=\"copyTextAll\">📋 Текст</button>\n          <button class=\"btn\" @click=\"downloadText\">💾 Текст</button>\n          <button class=\"btn\" @click=\"exportStructure('xlsx')\" :disabled=\"!flatList.length\">💾 Excel</button>\n          <button class=\"btn\" @click=\"exportStructure('docx')\" :disabled=\"!flatList.length\">💾 Word</button>\n        </div>\n\n        <div class=\"root-zone\" :class=\"{ 'drop-root': dragOverRoot }\" @dragover.prevent=\"onRootDragOver\" @dragleave=\"dragOverRoot = false\" @drop.prevent=\"onRootDrop\" @click=\"activeSectionUid = null\">\n          <div class=\"root-title\" :class=\"{ 'root-active': !activeSectionUid }\">Главный раздел</div>\n          <div v-if=\"!flatList.length\" class=\"hint\">Выделяйте фрагменты на изображении — они появятся здесь. Начало блока — выделение раздела.</div>\n          <div v-for=\"f in flatList\" :key=\"f.node.uid\" class=\"block\" :class=\"{ 'block-active': isActive(f), 'drop-over': dropOverUid === f.node.uid }\"\n            :style=\"{ marginLeft: (f.depth * 18) + 'px' }\"\n            draggable=\"true\"\n            @dragstart=\"onDragStart(f.node.uid, $event)\"\n            @dragover.prevent=\"onBlockDragOver(f)\"\n            @dragleave=\"dropOverUid = null\"\n            @drop.prevent=\"onBlockDrop(f)\"\n            @click.stop=\"activate(f)\"\n          >\n            <div class=\"block-head\">\n              <div v-if=\"f.node.region\" class=\"frag-crop\" :style